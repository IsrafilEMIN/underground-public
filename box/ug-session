#!/bin/sh
set -eu
export HOME=/home/agent
export TMPDIR=/home/agent/.tmp
mkdir -p "$TMPDIR"
if [ -z "${UG_REPO:-}" ]; then
  mkdir -p "$HOME/scratch"
  cd "$HOME/scratch"
  exec omp "$@"
fi
clone=$HOME/work/$UG_REPO
if [ ! -d "$clone/.git" ]; then
  rm -rf "$clone"
  mkdir -p "$clone"
  git -C "$clone" init -q
  git -C "$clone" remote add origin "https://github.com/$UG_REPO.git"
fi
cd "$clone"
synced=$(flock .git/ug-sync.lock broker sync "$UG_REPO") || {
  echo "ug-session: broker sync $UG_REPO failed; is the broker app installed on it?" >&2
  exit 69
}
branch=$(printf '%s\n' "$synced" | sed -n 's|^origin/\([^ ]*\) is now .*|\1|p')
[ -n "$branch" ] || { echo "ug-session: broker sync gave no branch: $synced" >&2; exit 69; }
checkout=$(ovnfs new "$clone" --rev "origin/$branch")
cd "$checkout"
exec omp "$@"
