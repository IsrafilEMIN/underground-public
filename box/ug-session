#!/bin/sh
# One omp session, run in the agent's private space. It opens an ovnfs checkout of the
# repo at GitHub's default branch as the owner's checkout last fetched it, never at the
# owner's working files, so the agent's work never carries unpushed local edits.
set -eu
export HOME=/home/agent
rev=origin/HEAD
git -C /repo rev-parse --verify --quiet "$rev" >/dev/null || rev=origin/main
checkout=$(ovnfs new /repo --rev "$rev")
cd "$checkout"
exec omp "$@"
