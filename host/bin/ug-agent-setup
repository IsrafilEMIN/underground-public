#!/usr/bin/env bash
set -Eeuo pipefail

if [[ $# -gt 1 ]]; then
  printf 'usage: sudo host/bin/ug-agent-setup [<downloaded omp>]\n' >&2
  exit 64
fi
staged=${1:-}

src=$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd -P)
# shellcheck source=host/lib/ug.bash disable=SC1091
source "$src/host/lib/ug.bash"
err_red=$(ug_paint 2 red) err_plain=$(ug_paint 2 off)

die() {
  printf '%sug-agent-setup: %s%s\n' "$err_red" "$*" "$err_plain" >&2
  exit 1
}

stopped() {
  local status=$1 line=$2 command=$3
  (( BASH_SUBSHELL == 0 )) || return 0
  printf '%sug-agent-setup: stopped at line %s of host/bin/ug-agent-setup: "%s" failed with exit %s. The steps above it are done, and nothing after it ran, so the agent user may be set up only in part. Fix the cause, then run host/bin/ug-setup again, which repeats every step.%s\n' "$err_red" "$line" "$command" "$status" "$err_plain" >&2
}
trap 'stopped $? $LINENO "$BASH_COMMAND"' ERR

[[ $(id -u) -eq 0 ]] || die "run it as root: sudo host/bin/ug-agent-setup"
owner=${SUDO_USER:-}
[[ -n $owner && $owner != root ]] || die "SUDO_USER is not set; run it with sudo from your own login"
owner_home=/Users/$owner
[[ -d $owner_home && ! -L $owner_home ]] || die "the home $owner_home is not a folder"

ug_check_checkout "$src" ug-agent-setup || exit 1

root=/Library/Underground
data=$owner_home/.local/share/underground
bin_dir=$owner_home/.local/bin
key_dir=$data/agent-ssh
owner_key=$key_dir/id_ed25519
known_hosts=$key_dir/known_hosts
ip_port='^[0-9]{1,3}(\.[0-9]{1,3}){3}:[0-9]{1,5}$'
omp_pin=$(ug_pin "$src/VERSIONS" omp)
omp_sha=$(ug_pin "$src/VERSIONS" omp_sha256)
[[ $omp_pin =~ ^[0-9A-Za-z.+-]+$ ]] || die "VERSIONS has no omp pin"
[[ $omp_sha =~ ^[0-9a-f]{64}$ ]] || die "VERSIONS has no omp_sha256 pin"

cleanup=()
trap '[[ ${#cleanup[@]} -eq 0 ]] || rm -rf "${cleanup[@]}"' EXIT

chmod 700 "$owner_home"
[[ -n $(find "$owner_home" -maxdepth 0 -perm 700 2>/dev/null) ]] || die "$owner_home is not mode 700 and would not stay so; nothing else is set up"
ug_say ok "owner home $owner_home" "mode 700"

next_uid() {
  local uid
  uid=$(dscl . -list /Users UniqueID | sed -n 's/.* //p' | sort -n | tail -1) || true
  uid=${uid:-0}
  printf '%s\n' $(( uid < 400 ? 400 : uid + 1 ))
}

make_user() {
  local name=$1 real=$2 shell=$3 uid pw
  if dscl . -read "/Users/$name" UniqueID >/dev/null 2>&1; then
    ug_say same "user $name" "exists"
  else
    uid=$(next_uid)
    pw=$(openssl rand -hex 24)
    dscl . -create "/Users/$name"
    dscl . -create "/Users/$name" UniqueID "$uid"
    dscl . -create "/Users/$name" PrimaryGroupID 20
    dscl . -create "/Users/$name" RealName "$real"
    dscl . -create "/Users/$name" NFSHomeDirectory "/Users/$name"
    dscl . -passwd "/Users/$name" "$pw"
    unset pw
    ug_say changed "user $name" "created, uid $uid, random password never shown"
  fi
  dscl . -create "/Users/$name" UserShell "$shell"
  dscl . -create "/Users/$name" IsHidden 1
  [[ " $(dscl . -read /Groups/admin GroupMembership 2>/dev/null) " != *" $name "* ]] ||
    die "$name is in the group admin; remove it: sudo dseditgroup -o edit -d $name -t user admin"
  install -d -m 700 -o "$name" -g staff "/Users/$name"
  ug_say ok "user $name" "standard, hidden, $shell, home /Users/$name mode 700"
}

agent_ssh=/Users/ugagent/.ssh
agent_is_new=1
if [[ -e /Users/ugagent || -L /Users/ugagent ]] || dscl . -read /Users/ugagent UniqueID >/dev/null 2>&1; then agent_is_new=0; fi
make_user ugagent "Underground agent" /bin/sh
make_user ugauth "Underground logins" /usr/bin/false

make_group() {
  local group=$1 real=$2 name
  shift 2
  dscl . -read "/Groups/$group" PrimaryGroupID >/dev/null 2>&1 || dseditgroup -o create -r "$real" "$group"
  for name in "$@"; do
    dseditgroup -o checkmember -m "$name" "$group" >/dev/null 2>&1 || dseditgroup -o edit -a "$name" -t user "$group"
  done
  if dseditgroup -o checkmember -m "$owner" "$group" >/dev/null 2>&1; then
    dseditgroup -o edit -d "$owner" -t user "$group"
  fi
  ug_say ok "group $group" "$*, not $owner"
}

make_group ugomp "Underground omp" ugagent ugauth
make_group ugagent "Underground agent config" ugagent

if [[ " $(dscl . -read /Groups/com.apple.access_ssh GroupMembership 2>/dev/null) " != *" ugagent "* ]]; then
  dscl . -append /Groups/com.apple.access_ssh GroupMembership ugagent
  ug_say changed "group com.apple.access_ssh" "ugagent added"
else
  ug_say same "group com.apple.access_ssh" "ugagent in place"
fi

if [[ $agent_is_new == 1 ]]; then
  install -d -m 755 -o root -g wheel "$agent_ssh"
  install -m 444 -o root -g wheel /dev/null "$agent_ssh/authorized_keys"
  ug_say changed "$agent_ssh" "root-owned, empty authorized_keys"
elif [[ ! -L $agent_ssh && $(stat -f '%Su %Lp' "$agent_ssh" 2>/dev/null) == "root 755" ]]; then
  ug_say same "$agent_ssh" "root-owned"
else
  ug_say ok "$agent_ssh" "not the root-owned folder that setup made; setup writes nothing in the agent's home after it makes the user, and the system sshd still denies ugagent"
fi

omp_dir=$root/omp/$omp_pin
omp_bin=$omp_dir/omp
install -d -m 755 -o root -g wheel "$root" "$root/omp" "$omp_dir" "$root/bin" "$root/gh-broker" "$root/authorized_keys"
if [[ -n $staged ]]; then
  [[ -f $staged && ! -L $staged ]] || die "the downloaded omp $staged is not a file"
  omp_tmp=$(mktemp "$omp_dir/.omp.XXXXXX")
  cleanup+=("$omp_tmp")
  cat "$staged" >"$omp_tmp"
  [[ $(ug_sha256 "$omp_tmp") == "$omp_sha" ]] || die "the downloaded omp does not have the pinned SHA-256; nothing changed"
  chown root:ugomp "$omp_tmp"
  chmod 550 "$omp_tmp"
  mv -f "$omp_tmp" "$omp_bin"
fi
[[ -f $omp_bin && ! -L $omp_bin ]] || die "no omp $omp_pin in $omp_dir; run host/bin/ug-setup, which downloads it"
[[ $(ug_sha256 "$omp_bin") == "$omp_sha" ]] || die "$omp_bin does not have the pinned SHA-256; run host/bin/ug-setup, which downloads it again"
ug_ensure_owner_mode "$omp_bin" root:ugomp 0550 || die "cannot make $omp_bin root:ugomp mode 0550; the agent could change the binary it runs"
printf '%s\n' "$omp_sha" >"$omp_dir/.omp.sha256.tmp"
install -m 444 -o root -g wheel "$omp_dir/.omp.sha256.tmp" "$omp_bin.sha256"
rm -f "$omp_dir/.omp.sha256.tmp"
ln -sfn "$omp_bin" "$root/bin/omp"
for old in "$root"/omp/*; do
  [[ $old == "$omp_dir" ]] || rm -rf "$old"
done
cat >"$root/bin/gh-broker.tmp" <<EOF
#!/bin/sh
BUN_BE_BUN=1 UG_GH_BROKER_SOCKET=$root/run/gh-broker.sock exec $root/omp/$omp_pin/omp $root/gh-broker/client.ts "\$@"
EOF
install -m 555 -o root -g wheel "$root/bin/gh-broker.tmp" "$root/bin/gh-broker"
rm -f "$root/bin/gh-broker.tmp"
install -m 444 -o root -g wheel "$src/host/gh-broker/client.ts" "$root/gh-broker/client.ts"
install -m 444 -o root -g wheel "$src/host/gh-broker/protocol.ts" "$root/gh-broker/protocol.ts"
install -m 444 -o root -g wheel "$src/host/gh-broker/sweep.ts" "$root/gh-broker/sweep.ts"
rm -rf "$root/broker" "$root/bin/broker" "$root/run/broker.sock" "$root/run/agent-sshd.pid"
/usr/bin/sandbox-exec -f "$src/host/agent/pin.sb" /usr/bin/true || die "host/agent/pin.sb does not load under sandbox-exec; the installed pin is unchanged"
install -m 444 -o root -g wheel "$src/host/agent/pin.sb" "$root/pin.sb"
install -m 555 -o root -g wheel "$src/host/agent/agent-session" "$root/agent-session"
install -m 555 -o root -g wheel "$src/host/agent/agent-start" "$root/agent-start"
install -m 555 -o root -g wheel "$src/host/agent/agent-refresh" "$root/agent-refresh"
install -m 444 -o root -g wheel "$src/host/agent/sshd_config" "$root/sshd_config"
install -m 444 -o root -g wheel "$src/host/agent/config-names" "$root/config-names"
ug_say ok "$root" "omp $omp_pin (old versions removed), pin.sb, bin/, gh-broker, agent-session, agent-start, agent-refresh, sshd_config installed"

install -d -m 710 -o "$owner" -g ugagent "$root/run"

if [[ ! -f $root/ssh_host_ed25519_key ]]; then
  ssh-keygen -q -t ed25519 -N '' -f "$root/ssh_host_ed25519_key"
fi
chown root:wheel "$root/ssh_host_ed25519_key" "$root/ssh_host_ed25519_key.pub"
chmod 600 "$root/ssh_host_ed25519_key"
chmod 644 "$root/ssh_host_ed25519_key.pub"
ug_say ok "agent sshd host key" "$root/ssh_host_ed25519_key"

deny=/etc/ssh/sshd_config.d/010-underground-deny-ugagent.conf
deny_tmp=$(mktemp)
cleanup+=("$deny_tmp")
printf 'DenyUsers ugagent\n' >"$deny_tmp"
install -m 444 -o root -g wheel "$deny_tmp" "$deny"
ug_sshd_denies_agent /etc/ssh/sshd_config "$root/ssh_host_ed25519_key" ||
  die "the system sshd does not deny ugagent with $deny in place; keep Remote Login off"
ug_say ok "system sshd" "$deny denies ugagent"

[[ -d $data ]] || die "$data does not exist; run host/bin/ug-setup first"
install -d -m 700 -o "$owner" -g staff "$key_dir"
if [[ ! -f $owner_key ]]; then
  ssh-keygen -q -t ed25519 -N '' -C ug-agent -f "$owner_key"
fi
chown "$owner" "$owner_key" "$owner_key.pub"
chmod 600 "$owner_key"
ug_say ok "owner key for the agent login" "$owner_key"

{ cut -d ' ' -f 1,2 "$owner_key.pub"; } >"$root/authorized_keys/ugagent.tmp"
install -m 444 -o root -g wheel "$root/authorized_keys/ugagent.tmp" "$root/authorized_keys/ugagent"
rm -f "$root/authorized_keys/ugagent.tmp"

host_key=$(cut -d ' ' -f 1,2 "$root/ssh_host_ed25519_key.pub")
printf '[127.0.0.1]:2222 %s\n' "$host_key" >"$known_hosts.tmp"
install -m 600 -o "$owner" -g staff "$known_hosts.tmp" "$known_hosts"
rm -f "$known_hosts.tmp"
ug_say ok "known_hosts for 127.0.0.1:2222" "$known_hosts"

vet_item() {
  local item=$1 base=$2 what=$3 secrets=$4 odd leak
  odd=$(find "$item" \( -type l -o ! -type f ! -type d \) -print 2>/dev/null | head -1) || true
  [[ -z $odd ]] || die "$what has a link or a special file, which the agent must not get: ${odd#"$base/"}"
  leak=$(grep -r -l -a -E -f "$src/host/secret-patterns" "$item" 2>/dev/null | head -1) || true
  [[ -n $leak || ! -s $secrets ]] || leak=$(grep -r -l -a -F -f "$secrets" "$item" 2>/dev/null | head -1) || true
  [[ -z $leak ]] || die "$what file ${leak#"$base/"} holds a token or a key; the agent reads every config file, so take it out"
}

stage_config() {
  local cfg gateway gateway_token stage name item secrets value token_file repo base n found
  cfg=$(sed -n '1p' "$data/config-repo" 2>/dev/null) || true
  [[ -n $cfg ]] || die "no config repo: $data/config-repo names none"
  cfg=${cfg/#\~/$owner_home}
  [[ -d $cfg && ! -L $cfg ]] || die "the config repo $cfg is not a folder"
  gateway=$(sed -n 's/^gateway=//p' "$data/addresses" 2>/dev/null) || true
  [[ $gateway =~ $ip_port ]] || die "the addresses file $data/addresses has no gateway=<ip>:<port> line"
  gateway_token=$({ tr -d '[:space:]' <"$auth_home/.omp/auth-gateway.token"; } 2>/dev/null) || gateway_token=""
  [[ $gateway_token =~ ^[A-Za-z0-9._~+=-]{12,}$ ]] || die "$auth_home/.omp/auth-gateway.token is missing or has characters the config cannot hold"
  stage=$(mktemp -d) || die "cannot make a temp folder for the config"
  cleanup+=("$stage")
  mkdir "$stage/repo" "$stage/out"
  git -c "safe.directory=$cfg" -C "$cfg" archive --format=tar HEAD | tar -x -C "$stage/repo" || die "cannot read the last commit of the config repo $cfg"
  secrets=$stage/secrets
  : >"$secrets"
  for token_file in "$auth_home/.omp/auth-broker.token" "$auth_home/.omp/auth-gateway.token"; do
    value=$({ tr -d '[:space:]' <"$token_file"; } 2>/dev/null) || value=""
    [[ ${#value} -lt 12 ]] || printf '%s\n' "$value" >>"$secrets"
  done
  while IFS= read -r name; do
    item=$stage/repo/$name
    [[ -e $item || -L $item ]] || continue
    vet_item "$item" "$stage/repo" "the config repo" "$secrets"
    [[ $name != models.yaml ]] || die "the config repo has models.yaml; name it models.yml"
    cp -R "$item" "$stage/out/$name"
  done <"$src/host/agent/config-names"
  n=0
  if [[ -e $stage/repo/skill-repos || -L $stage/repo/skill-repos ]]; then
    [[ -f $stage/repo/skill-repos && ! -L $stage/repo/skill-repos ]] || die "skill-repos in the config repo must be a file, not a link or a folder"
    while IFS= read -r repo || [[ -n $repo ]]; do
      [[ -n $repo ]] || continue
      repo=${repo/#\~/$owner_home}
      [[ -d $repo && ! -L $repo ]] || die "the skill repo $repo in the config repo's skill-repos is not a folder"
      repo=$(cd "$repo" && pwd -P) || die "cannot open the skill repo $repo"
      [[ $repo == "$owner_home"/* ]] || die "the skill repo $repo is not inside $owner_home; setup reads skill repos only from your home"
      n=$((n + 1))
      base=$stage/skill-repo-$n
      mkdir "$base"
      git -c "safe.directory=$repo" -C "$repo" archive --format=tar HEAD | tar -x -C "$base" || die "cannot read the last commit of the skill repo $repo"
      [[ ! -L $base/skills ]] || die "the skill repo $repo has skills as a link, which the agent must not get"
      [[ ! -d $base/skills ]] || base=$base/skills
      found=0
      for item in "$base"/*/; do
        item=${item%/}
        [[ -f $item/SKILL.md || -L $item ]] || continue
        name=${item##*/}
        vet_item "$item" "$base" "the skill repo $repo" "$secrets"
        [[ ! -e $stage/out/skills/$name ]] || die "the skill $name of the skill repo $repo is also in the config repo or an earlier skill repo; rename one"
        mkdir -p "$stage/out/skills"
        cp -R "$item" "$stage/out/skills/$name"
        found=$((found + 1))
      done
      [[ $found -gt 0 ]] || die "the last commit of the skill repo $repo has no <name>/SKILL.md at its top or under skills/"
      ug_say ok "skill repo $repo" "$found skills"
    done <"$stage/repo/skill-repos"
  fi
  [[ -f $stage/out/models.yml ]] || die "the last commit of the config repo $cfg has no models.yml"
  sed -i.bak -e "s/@GATEWAY@/$gateway/g" -e "s/@GATEWAY_TOKEN@/$gateway_token/g" "$stage/out/models.yml"
  rm -f "$stage/out/models.yml.bak"
  if grep -qE '@[A-Z_]+@' "$stage/out/models.yml"; then die "models.yml of the config repo has an unknown placeholder"; fi
  rm -rf "$root/config.new" "$root/config.old"
  cp -R "$stage/out" "$root/config.new"
  chown -R root:ugagent "$root/config.new"
  chmod -R u=rwX,g=rX,o= "$root/config.new"
  [[ ! -e $root/config ]] || mv "$root/config" "$root/config.old"
  mv "$root/config.new" "$root/config"
  rm -rf "$root/config.old"
  ug_say ok "agent config" "$root/config from $cfg, gateway $gateway"
}

auth_home=/Users/ugauth
install -d -m 700 -o ugauth -g staff "$auth_home/.omp" "$auth_home/logs"
if [[ ! -s $auth_home/.omp/auth-gateway.token ]]; then
  token_tmp=$(mktemp)
  cleanup+=("$token_tmp")
  openssl rand -hex 32 >"$token_tmp"
  install -m 600 -o ugauth -g staff "$token_tmp" "$auth_home/.omp/auth-gateway.token"
  ug_say changed "gateway bearer" "new, in $auth_home/.omp/auth-gateway.token"
fi
stage_config

start_login_services() {
  local owner_uid gateway engine label rendered f url err out fp inputs broker_out=""
  owner_uid=$(id -u "$owner")
  gateway=$(sed -n 's/^gateway=//p' "$data/addresses")
  engine=$(sed -n 's/^engine=//p' "$data/addresses")
  [[ $gateway =~ $ip_port && $engine =~ $ip_port ]] || die "$data/addresses needs a gateway=<ip>:<port> and an engine=<ip>:<port> line"
  install -d -m 755 -o root -g wheel "$root/usage-broker"
  for f in usage-broker.ts addresses.ts protocol.ts; do
    install -m 444 -o root -g wheel "$src/host/gh-broker/$f" "$root/usage-broker/$f"
  done
  install -m 444 -o root -g wheel "$data/addresses" "$root/addresses"
  install -d -m 700 -o root -g wheel "$root/state"
  for label in com.underground.auth-broker com.underground.auth-gateway com.underground.usage-broker; do
    err=$(ug_stop_service "gui/$owner_uid/$label") || die "$err"
    rm -f "$owner_home/Library/LaunchAgents/$label.plist"
    rendered=$(mktemp)
    cleanup+=("$rendered")
    out=$(ug_render_plist "$rendered" "$src/host/agent/$label.plist" "host/agent/$label.plist" -e "s|@OMP@|$omp_bin|g" -e "s|@GATEWAY@|$gateway|g" -e "s|@ENGINE@|$engine|g") || die "$out"
    inputs=()
    case $label in
      com.underground.auth-broker)
        url=http://127.0.0.1:8765/v1/healthz
        inputs=("$omp_bin.sha256")
        [[ ! -e $auth_home/.omp/auth-broker.token ]] || inputs+=("$auth_home/.omp/auth-broker.token")
        ;;
      com.underground.auth-gateway)
        url=http://$gateway/healthz
        inputs=("$omp_bin.sha256" "$auth_home/.omp/auth-gateway.token")
        [[ ! -e $auth_home/.omp/auth-broker.token ]] || inputs+=("$auth_home/.omp/auth-broker.token")
        ;;
      com.underground.usage-broker)
        url=http://127.0.0.1:18765/v1/healthz
        inputs=("$omp_bin.sha256" "$root/usage-broker/usage-broker.ts" "$root/usage-broker/addresses.ts" "$root/usage-broker/protocol.ts")
        ;;
    esac
    out=$(ug_trusted_daemon "$rendered") || die "a wall is open in the service $label: $out, so a user with fewer rights could change what it runs"
    [[ $label == com.underground.usage-broker || ! -e $auth_home/.omp/agent/config.yml ]] || inputs+=("$auth_home/.omp/agent/config.yml")
    [[ $label != com.underground.auth-gateway || $broker_out != restarted* ]] || rm -f "$root/state/$label.fingerprint"
    fp=$(ug_fingerprint "$rendered" "${inputs[@]}") || die "cannot read the inputs of $label: ${inputs[*]}"
    out=$(ug_ensure_service system "$label" "$rendered" "/Library/LaunchDaemons/$label.plist" "$root/state/$label.fingerprint" "$fp" ug_http_answers "$url") ||
      die "$out; read /Users/ugauth/logs/${label#com.underground.}.log"
    [[ $label != com.underground.auth-broker ]] || broker_out=$out
    ug_say "$(ug_service_kind "$out")" "login service $label at $url" "$out"
  done
  ug_say ok "login services" "auth-broker, auth-gateway, usage-broker run as ugauth from /Library/LaunchDaemons"
}
start_login_services

plist=/Library/LaunchDaemons/com.underground.agent-sshd.plist
/usr/sbin/sshd -t -f "$root/sshd_config" || die "sshd rejects $root/sshd_config; nothing was loaded"
for label in com.underground.agent-sshd com.underground.agent-refresh; do
  out=$(ug_trusted_daemon "$src/host/agent/$label.plist") || die "a wall is open in the service $label: $out, so a user with fewer rights could change what it runs"
done
fp=$(ug_fingerprint "$src/host/agent/com.underground.agent-sshd.plist" "$root/sshd_config" "$root/ssh_host_ed25519_key.pub") || die "cannot read the inputs of the agent sshd"
out=$(ug_ensure_service system com.underground.agent-sshd "$src/host/agent/com.underground.agent-sshd.plist" "$plist" "$root/state/com.underground.agent-sshd.fingerprint" "$fp" ug_port_answers 127.0.0.1 2222) ||
  die "agent sshd: $out; check it with: sudo launchctl print system/com.underground.agent-sshd"
ug_say "$(ug_service_kind "$out")" "agent sshd at 127.0.0.1:2222" "$out"

label=com.underground.agent-refresh
fp=$(ug_fingerprint "$src/host/agent/$label.plist") || die "cannot read host/agent/$label.plist"
out=$(ug_ensure_service system "$label" "$src/host/agent/$label.plist" "/Library/LaunchDaemons/$label.plist" "$root/state/$label.fingerprint" "$fp" launchctl print "system/$label") ||
  die "agent clone refresh: $out; check it with: sudo launchctl print system/$label"
ug_say "$(ug_service_kind "$out")" "agent clone refresh every 30 s" "$out"

agent_dir=$data/agent
install -d -m 700 -o "$owner" -g staff "$agent_dir" "$agent_dir/bin" "$agent_dir/lib"
[[ -d $bin_dir ]] || install -d -m 755 -o "$owner" -g staff "$bin_dir"
install -m 555 -o "$owner" -g staff "$src/host/bin/ug-agent" "$agent_dir/bin/ug-agent"
install -m 444 -o "$owner" -g staff "$src/host/lib/ug.bash" "$agent_dir/lib/ug.bash"
[[ ! -e $bin_dir/omp || -L $bin_dir/omp ]] || die "$bin_dir/omp is a file, not setup's link; move it away, then run setup again"
ln -sfn "$agent_dir/bin/ug-agent" "$bin_dir/omp"
chown -h "$owner" "$bin_dir/omp"
ug_say ok "omp on PATH" "$bin_dir/omp, the agent's launcher"

install -m 555 -o root -g wheel "$src/host/agent/agent-home-tar" "$root/bin/agent-home-tar"
sudoers_tmp=$(mktemp) || die "cannot make a temp file for the backup sudoers rule"
cleanup+=("$sudoers_tmp")
printf '%s ALL=(root) NOPASSWD: %s\n' "$owner" "$root/bin/agent-home-tar" >"$sudoers_tmp"
visudo -cf "$sudoers_tmp" >/dev/null || die "the sudoers rule for the backup does not check; nothing was installed"
install -m 440 -o root -g wheel "$sudoers_tmp" /etc/sudoers.d/underground-backup
ug_say ok backup "$root/bin/agent-home-tar, and sudo for $owner to run it (/etc/sudoers.d/underground-backup)"
