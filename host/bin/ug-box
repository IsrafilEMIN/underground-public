#!/usr/bin/env bash
set -euo pipefail

self=${BASH_SOURCE[0]}
while [[ -L $self ]]; do
  target=$(readlink "$self")
  [[ $target == /* ]] || target=$(dirname "$self")/$target
  self=$target
done
SRC=$(cd "$(dirname "$self")/../.." && pwd -P)
STATE=${UG_BOX_STATE:-$HOME/.local/state/underground/box}
LOCK_WAIT=${UG_BOX_LOCK_WAIT:-30}
READY_WAIT=${UG_BOX_READY_WAIT:-20}
NODE=${UG_BOX_NODE:-/opt/homebrew/bin/node}
UG=${UG_DIR:-$HOME/.ug}
EGRESS=${UG_BOX_EGRESS_SOCKET:-$UG/run/egress.sock}
BROKER=${UG_BOX_BROKER:-$UG/run/broker.sock}
PROXY=http://127.0.0.1:3128
NAME=ug-box
DIR=$STATE/$NAME

die() { echo "ug-box: $*" >&2; exit 1; }

# shellcheck source=host/lib/box-image.bash disable=SC1091
source "$SRC/host/lib/box-image.bash"

image_tag() { box_image_tag "$SRC"; }

lock() { ug_lock "$1" "$LOCK_WAIT" || die "another start holds the lock of $(basename "$1")"; }
unlock() { ug_unlock "$1"; }

live_sessions() {
  local f n=0
  for f in "$1"/sessions/*; do
    [[ -e $f ]] || continue
    if kill -0 "$(basename "$f")" 2>/dev/null; then n=$((n + 1)); else rm -f "$f"; fi
  done
  echo "$n"
}

running() { container list --quiet | grep -qxF "$1"; }

egress_up() {
  local waited=0
  until [[ -S $EGRESS ]]; do
    (( waited++ < READY_WAIT * 10 )) || die "the egress door is not running: no socket at $EGRESS.
launchd restarts it on its own (com.underground.egress); if it stays down, see ~/.ug/host/egress.log, or run host/bin/ug-setup."
    sleep 0.1
  done
}

box_config() {
  local repo_file=$UG/host/config-repo cfg gateway stage name item odd leak secrets
  cfg=$(sed -n '1p' "$repo_file" 2>/dev/null) || true
  [[ -n $cfg ]] || die "no config repo: $repo_file names none"
  cfg=${cfg/#\~/$HOME}
  [[ -d $cfg && ! -L $cfg ]] || die "the config repo $cfg is not a folder"
  gateway=$(sed -n 's/^gateway=//p' "$UG/host/addresses" 2>/dev/null) || true
  [[ $gateway == *:* ]] || die "the addresses file $UG/host/addresses has no gateway=<address>:<port> line"
  stage=$(mktemp -d) || die "cannot make a temp folder for the config"
  mkdir "$stage/repo" "$stage/out" || die "cannot use the temp folder $stage"
  git -C "$cfg" archive --format=tar HEAD | tar -x -C "$stage/repo" || { rm -rf "$stage"; die "cannot read the last commit of the config repo $cfg"; }
  [[ -z $(git -C "$cfg" status --porcelain 2>/dev/null) ]] ||
    echo "ug-box: the config repo has changes that are not committed; the box gets its last commit" >&2
  secrets=$stage/secrets
  : >"$secrets"
  local token_file value
  for token_file in "$UG/host/auth/auth-broker.token" "$UG/host/auth/auth-gateway.token"; do
    value=$({ tr -d '[:space:]' <"$token_file"; } 2>/dev/null) || value=""
    [[ ${#value} -lt 12 ]] || printf '%s\n' "$value" >>"$secrets"
  done
  while IFS= read -r name; do
    item=$stage/repo/$name
    [[ -e $item || -L $item ]] || continue
    odd=$(find "$item" \( -type l -o ! -type f ! -type d \) -print 2>/dev/null | head -1)
    [[ -z $odd ]] || { rm -rf "$stage"; die "the config repo has a link or a special file, which the box must not get: ${odd#"$stage/repo/"}"; }
    leak=$(grep -r -l -a -E -f "$SRC/host/secret-patterns" "$item" 2>/dev/null | head -1) || true
    [[ -n $leak || ! -s $secrets ]] || leak=$(grep -r -l -a -F -f "$secrets" "$item" 2>/dev/null | head -1) || true
    [[ -z $leak ]] || { rm -rf "$stage"; die "the config repo file ${leak#"$stage/repo/"} holds a token or a key; the agent reads every config file, so take it out"; }
    [[ $name != models.yaml ]] || { rm -rf "$stage"; die "the config repo has models.yaml; name it models.yml"; }
    cp -R "$item" "$stage/out/$name"
  done <"$SRC/box/config-names"
  [[ -f $stage/out/models.yml ]] || { rm -rf "$stage"; die "the last commit of the config repo $cfg has no models.yml"; }
  sed -i.bak -e "s/@GATEWAY@/gateway.internal:${gateway##*:}/g" -e "s/@GATEWAY_TOKEN@/ug-placeholder/g" "$stage/out/models.yml"
  rm -f "$stage/out/models.yml.bak"
  if grep -qE '@[A-Z_]+@' "$stage/out/models.yml"; then rm -rf "$stage"; die "models.yml of the config repo has an unknown placeholder"; fi
  COPYFILE_DISABLE=1 tar -c -f "$stage/config.tar" -C "$stage/out" .
  echo "$stage"
}

repo_slug() {
  local top url re='^(git@github\.com:|ssh://git@github\.com/|https://github\.com/)([A-Za-z0-9_.-]+)/([A-Za-z0-9_.-]+)$'
  top=$(git rev-parse --show-toplevel 2>/dev/null) || return 0
  url=$(git -C "$top" config --get remote.origin.url 2>/dev/null) || true
  url=${url%/}
  url=${url%.git}
  [[ $url =~ $re ]] || die "$top has no GitHub origin, so the box cannot clone it"
  echo "${BASH_REMATCH[2]}/${BASH_REMATCH[3]}"
}

boot() {
  local tag=$1 gone=0
  while container list --all --quiet | grep -qxF "$NAME"; do
    (( gone++ < READY_WAIT * 10 )) || die "the old box $NAME is still there"
    sleep 0.1
  done
  if ! container volume list --quiet | grep -qxF "$NAME-home"; then
    box_home_create "$NAME-home"
  elif ! box_home_capped "$NAME-home"; then
    die "the box home $NAME-home has no size cap of $BOX_HOME_SIZE. With no session open, run: launchctl kickstart gui/\$UID/com.underground.backup; when ~/.ug/host/backup/last shows the new time, run: ug-box-restore"
  fi
  container run --detach --rm --name "$NAME" \
    --network none --read-only --tmpfs /tmp \
    --volume "$NAME-home:/home/agent" \
    --volume "$EGRESS:/tmp/ug-egress.sock" \
    --volume "$BROKER:/tmp/ug-broker.sock" \
    "$tag" /usr/local/bin/ug-init >/dev/null
  local waited=0
  until container exec "$NAME" test -e /tmp/ug-ready 2>/dev/null; do
    (( waited++ < READY_WAIT * 10 )) || { container stop "$NAME" >/dev/null 2>&1 || true; die "the box did not get ready"; }
    sleep 0.1
  done
}

backup_warning() {
  local last
  last=$(cat "$UG/host/backup/last" 2>/dev/null) || last=""
  if [[ ! $last =~ ^[0-9]+$ ]]; then
    echo "ug-box: warning: the backup has never run; see ~/.ug/host/backup/backup.log" >&2
  elif (( $(date +%s) - last > 2 * 86400 )); then
    echo "ug-box: warning: the last backup is $(( ($(date +%s) - last) / 86400 )) days old; see ~/.ug/host/backup/backup.log" >&2
  fi
}

session() {
  local slug tag
  slug=$(repo_slug)
  tag=$(image_tag)
  backup_warning
  container image list --quiet | grep -qE "(^|/)${tag}\$" ||
    die "the box image for the current pins is not built (${tag#ugbox:}).
VERSIONS or the box files changed since the last setup. Run: host/bin/ug-setup"
  [[ -S $BROKER ]] || die "the GitHub broker is not running: no socket at $BROKER"
  mkdir -p "$DIR/sessions"
  STAGE=$(box_config)
  trap 'rm -rf "$STAGE"' EXIT
  egress_up

  lock "$DIR"
  if running "$NAME"; then
    if [[ $(cat "$DIR/image" 2>/dev/null) != "$tag" ]]; then
      local open
      open=$(live_sessions "$DIR")
      if [[ $open -gt 0 ]]; then
        unlock "$DIR"
        die "update waiting.
A newer box image is built (new omp, ovnfs, or box files), but the box still runs the old one,
because $open omp session(s) are open in it. A running box is never restarted under an open session.
To start on the new image: quit those sessions, then run ug-box again."
      fi
      container stop "$NAME" >/dev/null
      boot "$tag"
    fi
  else
    boot "$tag"
  fi
  if [[ $(container inspect "$NAME" | "$NODE" "$SRC/host/bin/ug-box-check.ts" "$NAME" "$tag" "$EGRESS" "$BROKER") != BOX_OK ]]; then
    [[ $(live_sessions "$DIR") -gt 0 ]] || container stop "$NAME" >/dev/null 2>&1 || true
    unlock "$DIR"
    die "the box failed its check (listed above), so no session started"
  fi
  echo "$tag" > "$DIR/image"
  : > "$DIR/sessions/$$"
  unlock "$DIR"
  container exec --interactive --uid 1000 --gid 1000 --env HOME=/home/agent "$NAME" /usr/local/bin/ug-config <"$STAGE/config.tar" ||
    { finish; die "the config did not go into the box"; }
  rm -rf "$STAGE"

  trap 'finish; exit 130' INT TERM HUP
  local status=0 tz
  tz=$(readlink /etc/localtime 2>/dev/null | sed -n 's|^.*/zoneinfo/||p')
  [[ $tz =~ ^[A-Za-z][A-Za-z0-9_+-]*(/[A-Za-z0-9_+-]+)*$ ]] || tz=UTC
  container exec --interactive --tty --uid 1000 --gid 1000 --env HOME=/home/agent --env "TZ=$tz" --env "UG_REPO=$slug" \
    --env "PI_PROXY=$PROXY" --env "HTTPS_PROXY=$PROXY" --env "HTTP_PROXY=$PROXY" \
    --env OMP_AUTH_BROKER_URL=http://usage.internal:18765 --env OMP_AUTH_BROKER_TOKEN=usage-only "$NAME" \
    nsenter --target 1 --user --mount --preserve-credentials -- /usr/local/bin/ug-session "$@" || status=$?
  trap - INT TERM HUP
  finish
  return "$status"
}

finish() {
  rm -f "$DIR/sessions/$$"
  lock "$DIR"
  if [[ $(live_sessions "$DIR") -eq 0 ]] && running "$NAME"; then
    container stop "$NAME" >/dev/null 2>&1 || true
  fi
  unlock "$DIR"
}

session "$@"
