#!/usr/bin/env bash
set -euo pipefail

if [[ $# -gt 1 ]]; then
  printf 'usage: ug-box-restore [snapshot]\n' >&2
  exit 64
fi
snapshot=${1:-latest}

restic_pin=$(sed -n 's/^restic=//p' "$HOME/.ug/sys/box/VERSIONS" 2>/dev/null || true)
restic_bin="$HOME/.ug/sys/restic/$restic_pin/restic"
backup="$HOME/.ug/host/backup"
state=${UG_BOX_STATE:-$HOME/.local/state/underground/box}/ug-box
node=${UG_BOX_NODE:-/opt/homebrew/bin/node}
lock="$state/lock"

die() { echo "ug-box-restore: $*" >&2; exit 1; }

[[ -n $restic_pin && -x $restic_bin ]] || die "the pinned restic is missing; run host/bin/ug-setup"
[[ -f $HOME/.ug/sys/box/host/lib/box-image.bash ]] || die "no installed box; run host/bin/ug-setup"
# shellcheck source=host/lib/box-image.bash disable=SC1091
source "$HOME/.ug/sys/box/host/lib/box-image.bash"
image=$(box_image_tag "$HOME/.ug/sys/box")
container image list --quiet | grep -qE "(^|/)${image}\$" || die "the box image $image is not built; run host/bin/ug-setup"
[[ -s $backup/password ]] || die "the backup password $backup/password is missing"
repo=$(sed -n 's/^repo=//p' "$backup/config" 2>/dev/null | sed -n '1p')
[[ -n $repo ]] || die "no repo= line in $backup/config"
export RESTIC_PASSWORD_FILE="$backup/password"

mkdir -p "$state"
mkdir "$lock" 2>/dev/null || die "ug-box holds its lock; end every session first"
echo $$ >"$lock/pid"
trap 'rm -rf "$lock"' EXIT
! container list --quiet | grep -qxF ug-box || die "the box is running; end every session first"

"$restic_bin" -r "$repo" cat config >/dev/null 2>&1 || die "the backup repo $repo does not open; is the backup target awake?"
id=$("$restic_bin" -r "$repo" snapshots --tag ug-box --json "$snapshot" | "$node" -e '
  let d = "";
  process.stdin.on("data", (c) => (d += c)).on("end", () => {
    const s = JSON.parse(d).find((x) => x.paths?.includes("/ug-box-home.tar") && (x.summary?.total_bytes_processed ?? 0) > 0);
    if (s) console.log(s.id);
  });')
[[ -n $id ]] || die "no box snapshot $snapshot in $repo holds ug-box-home.tar"

tar_sh='tar -C /home/agent -c --exclude ./.tmp --exclude ./.cache --exclude ./.omp/agent/cache --exclude node_modules . ; [ $? -le 1 ]'
if container volume list --quiet | grep -qxF ug-box-home; then
  "$restic_bin" -r "$repo" backup --quiet --tag ug-box-prerestore --stdin-filename ug-box-home.tar --stdin-from-command -- \
    container run --rm --network none --volume ug-box-home:/home/agent "$image" sh -c "$tar_sh" ||
    die "the old box home did not reach $repo, so nothing was deleted"
  echo "ug-box-restore: the old box home is in $repo with tag ug-box-prerestore"
  container volume delete ug-box-home >/dev/null
fi
box_home_create ug-box-home
"$restic_bin" -r "$repo" dump "$id" ug-box-home.tar |
  container run --rm --interactive --network none --volume ug-box-home:/home/agent "$image" tar -x -C /home/agent ||
  die "the restore of snapshot ${id:0:8} broke partway; the box home is incomplete. Run ug-box-restore again, or with the id of the ug-box-prerestore snapshot for the old home"
echo "ug-box-restore: the box home is back from snapshot ${id:0:8}; the next ug-box starts on it"
