#!/usr/bin/env bash
set -euo pipefail

if [[ $# -gt 1 ]]; then
  printf 'usage: ug-box-restore [snapshot]\n' >&2
  exit 64
fi
snapshot=${1:-latest}

restic_pin=$(sed -n 's/^restic=//p' "$HOME/.ug/sys/box/VERSIONS" 2>/dev/null || true)
restic_bin="$HOME/.ug/sys/restic/$restic_pin/restic"
backup="$HOME/.ug/host/backup"

die() { echo "ug-box-restore: $*" >&2; exit 1; }

[[ -n $restic_pin && -x $restic_bin ]] || die "the pinned restic is missing; run host/bin/ug-setup"
[[ -f $HOME/.ug/sys/box/host/lib/box-image.bash ]] || die "no installed box; run host/bin/ug-setup"
# shellcheck source=host/lib/box-image.bash disable=SC1091
source "$HOME/.ug/sys/box/host/lib/box-image.bash"
image=$(box_image_tag "$HOME/.ug/sys/box")
container image list --quiet | grep -qE "(^|/)${image}\$" || die "the box image $image is not built; run host/bin/ug-setup"
[[ -s $backup/password ]] || die "the backup password $backup/password is missing"
repo=$(sed -n 's/^repo=//p' "$backup/config" 2>/dev/null | sed -n '1p')
[[ -n $repo ]] || die "no repo= line in $backup/config"
export RESTIC_PASSWORD_FILE="$backup/password"

! container list --quiet | grep -qxF ug-box || die "the box is running; end every session first"

"$restic_bin" -r "$repo" snapshots --tag ug-box --json "$snapshot" | grep -q '"ug-box-home.tar"' ||
  die "no box snapshot $snapshot in $repo with tag ug-box"

if container volume list --quiet | grep -qxF ug-box-home; then
  container volume delete ug-box-home >/dev/null
  echo "ug-box-restore: deleted the old box home"
fi
container volume create ug-box-home >/dev/null
"$restic_bin" -r "$repo" dump "$snapshot" ug-box-home.tar |
  container run --rm --interactive --network none --volume ug-box-home:/home/agent "$image" tar -x -C /home/agent
echo "ug-box-restore: the box home is back from snapshot $snapshot; the next ug-box starts on it"
