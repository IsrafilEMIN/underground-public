#!/usr/bin/env bash
set -euo pipefail

self=${BASH_SOURCE[0]}
while [[ -L $self ]]; do
  target=$(readlink "$self")
  [[ $target == /* ]] || target=$(dirname "$self")/$target
  self=$target
done
# shellcheck source=host/lib/ug.bash disable=SC1091
source "$(dirname "$self")/../lib/ug.bash"

UG=${UG_DIR:-$HOME/.local/share/underground}
key=$UG/agent-ssh/id_ed25519
known_hosts=$UG/agent-ssh/known_hosts
sshd_config=${UG_SSHD_CONFIG:-/etc/ssh/sshd_config}
re='^[A-Za-z0-9._=:/@+-]+$'

die() { echo "ug-agent: $*" >&2; exit 1; }

[[ -n $(find "$HOME" -maxdepth 0 -perm 700 2>/dev/null) ]] ||
  die "your home $HOME is not mode 700; the agent user could read it. Run: host/bin/ug-setup"

last=$UG/backup/last
if [[ ! -s $last ]] || (( $(date +%s) - $(<"$last") > 36 * 3600 )); then
  echo "ug-agent: warning: the agent home has no backup from the last 36 hours; see $UG/backup/backup.log" >&2
fi

for arg in "$@"; do
  [[ $arg =~ $re ]] || die "refused argument $arg: only letters, digits and . _ = : / @ + - are allowed"
done

[[ -f $key && -f $known_hosts ]] || die "no agent key or known_hosts under $UG/agent-ssh; run: host/bin/ug-setup"

if launchctl print system/com.openssh.sshd >/dev/null 2>&1; then
  /usr/sbin/sshd -T -f "$sshd_config" -o HostKey="$key" -C user=ugagent,host=localhost,addr=127.0.0.1 2>/dev/null | grep -qix 'denyusers ugagent' ||
    die "system Remote Login is running, and the system sshd does not deny ugagent; without that, the agent user could log in there outside the pin. Run host/bin/ug-setup, or turn Remote Login off."
fi

top=$(git rev-parse --show-toplevel 2>/dev/null) || top=
if [[ -n $top ]]; then
  slug=$(ug_repo_slug "$top") || die "$top has no GitHub origin, so the agent cannot clone it"
  [[ -z $slug ]] || export UG_REPO=$slug
fi

exec ssh -tt -p 2222 -i "$key" -o IdentitiesOnly=yes -o UserKnownHostsFile="$known_hosts" -o StrictHostKeyChecking=yes -o LogLevel=ERROR -o SendEnv=UG_REPO ugagent@127.0.0.1 -- "$@"
