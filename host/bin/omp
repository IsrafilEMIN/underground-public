#!/usr/bin/env bash
set -euo pipefail

omp_pin='@OMP_PIN@'
omp_bin="$HOME/Library/Application Support/Tern/omp/versions/$omp_pin"
srt_pin='@SRT_PIN@'
srt_dir="$HOME/.agents/srt/$srt_pin"
srt_pkg="$srt_dir/node_modules/@anthropic-ai/sandbox-runtime/package.json"
srt_cli="$srt_dir/node_modules/@anthropic-ai/sandbox-runtime/dist/cli.js"
node_bin=/opt/homebrew/bin/node
render_settings="$HOME/.agents/sandbox/render-settings"
broker_admin="$HOME/.agents/broker/admin.ts"
omp_root="$HOME/.ug/omp"
ug_root="$omp_root/underground"
store_root="$HOME/.ug/git"
role_rules_root="$HOME/.agents/roles"
roles_file="$HOME/.config/underground-broker/roles"
wt_root="$HOME/.omp/wt"
install_record="$HOME/.agents/install-manifest"
github_key="$HOME/.config/underground-broker/github-app.pem"
service_labels="com.underground.broker com.underground.auth-broker com.underground.auth-gateway com.underground.usage-broker"

find_repo_folder() {
  local dir
  dir=$(pwd -P)
  while :; do
    if [[ -e $dir/.git || -L $dir/.git ]]; then
      if [[ -d $dir/.git && ! -L $dir/.git ]]; then
        printf '%s\n' "$dir"
        return 0
      fi
      printf 'omp: start omp in the repo folder, not inside a worktree\n' >&2
      return 64
    fi
    [[ $dir == / ]] && return 0
    dir=$(dirname "$dir")
  done
}

tilde() {
  if [[ $1 == "$HOME" || $1 == "$HOME"/* ]]; then
    printf '~%s\n' "${1#"$HOME"}"
  else
    printf '%s\n' "$1"
  fi
}

path_hash() {
  local hash
  hash=$(printf '%s' "$1" | shasum -a 256)
  printf '%s\n' "${hash:0:8}"
}

check_srt() {
  local pkg="" version="" re='"version"[[:space:]]*:[[:space:]]*"([^"]*)"'
  if [[ ! -x $node_bin ]]; then
    printf 'omp: missing %s\n' "$node_bin" >&2
    return 1
  fi
  if [[ ! -f $srt_cli || ! -f $srt_pkg ]]; then
    printf 'omp: srt %s is not installed in %s; run install.sh\n' "$srt_pin" "$srt_dir" >&2
    return 1
  fi
  IFS= read -r -d '' pkg <"$srt_pkg" || true
  [[ $pkg =~ $re ]] && version=${BASH_REMATCH[1]}
  if [[ $version != "$srt_pin" ]]; then
    printf 'omp: srt in %s has version %s, want %s; run install.sh\n' "$srt_dir" "${version:-unknown}" "$srt_pin" >&2
    return 1
  fi
}

# Preflight runs at each launch. The install proved that the controls work; preflight checks that this mac
# is still in the state that the install recorded in its install record. It only reads. A broken control
# refuses the launch; a missing capability warns, and the launch goes on.
preflight() {
  local failed=0 kind mode hash path want_os="" have_os i idx line out label need
  local kinds=() modes=() hashes=() paths=() present=() files=() file_idx=()
  local redo="run ug-install"
  if [[ ! -f $install_record ]]; then
    printf 'omp: preflight: no install record in %s; %s\n' "$(tilde "$install_record")" "$redo" >&2
    return 1
  fi
  while IFS=$'\t' read -r kind mode hash path; do
    case $kind in
      os) want_os=$mode ;;
      dir | file)
        kinds+=("$kind")
        modes+=("$mode")
        hashes+=("$hash")
        paths+=("$path")
        ;;
    esac
  done <"$install_record"

  have_os=$(sw_vers -buildVersion 2>/dev/null) || have_os=""
  if [[ -z $have_os || $have_os != "$want_os" ]]; then
    printf 'omp: preflight: macOS is build %s, but the install proved the sandbox on build %s; %s\n' "${have_os:-unknown}" "${want_os:-unknown}" "$redo" >&2
    failed=1
  fi

  for ((i = 0; i < ${#paths[@]}; i++)); do
    path=${paths[i]}
    if [[ -L $path ]] || { [[ ${kinds[i]} == dir ]] && [[ ! -d $path ]]; } || { [[ ${kinds[i]} == file ]] && [[ ! -f $path ]]; }; then
      printf 'omp: preflight: %s is no longer the %s that the install wrote; %s\n' "$(tilde "$path")" "${kinds[i]}" "$redo" >&2
      failed=1
    elif [[ ! -O $path ]]; then
      printf 'omp: preflight: %s is not owned by you; %s\n' "$(tilde "$path")" "$redo" >&2
      failed=1
    else
      present+=("$i")
    fi
  done
  if [[ ${#present[@]} -gt 0 ]]; then
    for idx in "${present[@]}"; do
      files+=("${paths[idx]}")
    done
    out=$(stat -f %Lp "${files[@]}") || return 1
    i=0
    while IFS= read -r mode; do
      idx=${present[i]}
      if [[ $mode != "${modes[idx]}" ]]; then
        printf 'omp: preflight: %s has mode %s, but the install set %s; %s\n' "$(tilde "${paths[idx]}")" "$mode" "${modes[idx]}" "$redo" >&2
        failed=1
      fi
      i=$((i + 1))
    done <<<"$out"
    files=()
    for idx in "${present[@]}"; do
      [[ ${kinds[idx]} == file ]] || continue
      files+=("${paths[idx]}")
      file_idx+=("$idx")
    done
  fi
  if [[ ${#files[@]} -gt 0 ]]; then
    out=$(shasum -a 256 "${files[@]}") || return 1
    i=0
    while IFS= read -r line; do
      idx=${file_idx[i]}
      if [[ ${line%% *} != "${hashes[idx]}" ]]; then
        printf 'omp: preflight: %s changed since the install; %s\n' "$(tilde "${paths[idx]}")" "$redo" >&2
        failed=1
      fi
      i=$((i + 1))
    done <<<"$out"
  fi

  if [[ -e $github_key || -L $github_key ]]; then
    if [[ -L $github_key || ! -f $github_key || ! -O $github_key || $(stat -f %Lp "$github_key") != 600 ]]; then
      printf 'omp: preflight: the broker app key %s must be a file owned by you with mode 600; run: chmod 600 %s\n' "$(tilde "$github_key")" "$(tilde "$github_key")" >&2
      failed=1
    fi
  fi

  if [[ ! -x $omp_bin ]]; then
    printf 'omp: preflight: the pinned omp %s is missing; %s\n' "$(tilde "$omp_bin")" "$redo" >&2
    failed=1
  fi

  for label in $service_labels; do
    out=$(launchctl print "gui/$(id -u)/$label" 2>/dev/null) || out=""
    [[ $out == *"state = running"* ]] && continue
    case $label in
      com.underground.broker) need="the session has no broker: no sync, push, PR, or merge" ;;
      com.underground.usage-broker) need="/usage shows no accounts" ;;
      *) need="model calls fail" ;;
    esac
    printf 'omp: preflight: warning: the launchd job %s is not running, so %s; start it with: launchctl kickstart gui/%s/%s\n' "$label" "$need" "$(id -u)" "$label" >&2
  done
  return "$failed"
}

# The sandbox gets no credential from the caller's environment. A name with one of these words between
# underscores, in any case, is dropped without a message, because dropping it is the control working; the
# wrapper sets its own variables, the auth broker token among them, after this.
drop_secret_env() {
  local name
  local re='_(TOKEN|SECRET|PASSWORD|PASSWD|PASSPHRASE|CREDENTIALS?|AUTH|KEY|APIKEY|PAT)_'
  shopt -s nocasematch
  while IFS= read -r name; do
    [[ _${name}_ =~ $re ]] && unset "$name"
  done < <(compgen -e)
  shopt -u nocasematch
}

make_private_dir() {
  local dir=$1 mode
  mkdir -m 700 "$dir" 2>/dev/null || true
  if [[ -L $dir || ! -d $dir || ! -O $dir ]]; then
    printf 'omp: %s must be a folder owned by you, not a symlink; remove it with: rm -rf %s, and start omp again\n' "$dir" "$dir" >&2
    return 1
  fi
  mode=$(stat -f %Lp "$dir") || return 1
  if [[ $mode != 700 ]]; then
    printf 'omp: %s has mode %s, want 700; run: chmod 700 %s\n' "$dir" "$mode" "$dir" >&2
    return 1
  fi
}

make_state_dir() {
  local state_root=$1 dir=$2 new
  if [[ ! -e $dir && ! -L $dir ]]; then
    new=$(mktemp -d "$state_root/.new.XXXXXX") || return 1
    if mkdir -m 700 "$new/omp"; then
      "$node_bin" -e 'require("node:fs").renameSync(process.argv[1], process.argv[2])' "$new" "$dir" 2>/dev/null || true
    fi
    rm -rf -- "$new"
  fi
  make_private_dir "$dir" && make_private_dir "$dir/omp"
}

# An omp daemon broker serves every session of this state folder and outlives them. One whose worker failed serves nobody,
# so stop it; omp in this session then starts a broker under the rules of this session. A broker with a live worker stays.
stop_failed_brokers() {
  local state=$1 dir pid
  for dir in "$state"/omp/run/daemons/*/*; do
    [[ -f $dir/broker.pid ]] || continue
    grep -qs '"state":"failed"' "$dir"/daemons/*/meta.json || continue
    pid=$(sed -n 's/.*"pid":\([0-9]*\).*/\1/p' "$dir/broker.pid")
    [[ -n $pid && $(ps -o command= -p "$pid" 2>/dev/null) == *" __omp_worker_daemon_broker" ]] || continue
    kill "$pid" 2>/dev/null && printf 'omp: stopped the daemon broker of %s, whose worker had failed\n' "${dir##*/}" >&2
  done
}

# One omp root serves every role, with one session folder and one state folder per repo for all roles. The wrapper
# makes its private folders; admin.ts start-session then writes the owner files from ~/.agents/roles when the role copy differs.
make_omp_root() {
  local dir agent=$omp_root/agent
  for dir in "$HOME/.ug" "$omp_root" "$agent" "$agent/cache" "$ug_root" "$ug_root/cache" "$ug_root/tmp" "$ug_root/state" "$agent/hooks" "$agent/hooks/pre"; do
    make_private_dir "$dir" || return 1
  done
}

make_review_store() {
  local store=$1
  make_private_dir "${store%/*}" && make_private_dir "$store" || return 1
  [[ -f $store/HEAD ]] && return 0
  GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_NOSYSTEM=1 git init --bare --quiet "$store"
}

refuse_config_flags() {
  local arg
  for arg in "$@"; do
    case $arg in
      --)
        return 0
        ;;
      --config | --config=* | --profile | --profile=*)
        printf 'omp: a role session takes its settings only from the policy in %s; remove %s\n' "$(tilde "$omp_root/agent/policy.yml")" "$arg" >&2
        return 64
        ;;
      --append-system-prompt | --append-system-prompt=*)
        printf 'omp: a role session takes its rules only from %s; remove %s\n' "$(tilde "$role_rules_root")" "$arg" >&2
        return 64
        ;;
    esac
  done
}

refuse_reviewer_flags() {
  local arg
  for arg in "$@"; do
    case $arg in
      --)
        return 0
        ;;
      --continue | --resume | --resume=* | --session | --session=* | --restore | --restore=* | --fork | --fork=* | --from-claude | --from-codex | -[cr]* | -[!-]*[cr]*)
        printf 'omp: a reviewer session always starts new; remove %s\n' "$arg" >&2
        return 64
        ;;
      --cwd | --cwd=* | --add-dir | --add-dir=*)
        printf 'omp: a reviewer session works in its store folder only; remove %s\n' "$arg" >&2
        return 64
        ;;
    esac
  done
}

main() {
  local cwd repo="" repo_hash rid wt_real state sessions settings startup broker_socket="" status=0
  local role_name=author role args=() cache_root tool_root store="" rules prefs rules_args=()
  while [[ $# -gt 0 ]]; do
    case $1 in
      --role)
        [[ $# -ge 2 ]] || { printf 'omp: --role needs a role name from %s\n' "$(tilde "$roles_file")" >&2; exit 64; }
        role_name=$2
        shift 2
        ;;
      --role=*)
        role_name=${1#--role=}
        shift
        ;;
      --review)
        printf 'omp: --review is gone; start a reviewer with --role <name>, a name from %s\n' "$(tilde "$roles_file")" >&2
        exit 64
        ;;
      *)
        args+=("$1")
        shift
        ;;
    esac
  done
  refuse_config_flags ${args[@]+"${args[@]}"} || exit 64
  cache_root="$ug_root/cache"
  tool_root="$cache_root/tools"
  cwd=$(pwd -P)
  wt_real=$(cd "$wt_root" 2>/dev/null && pwd -P) || wt_real=$wt_root
  if [[ $cwd == "$wt_real" || $cwd == "$wt_real"/* ]]; then
    printf 'omp: %s is in %s, the worktree folder of the agent. Start omp in the repo folder.\n' "$(tilde "$cwd")" "$(tilde "$wt_root")" >&2
    exit 64
  fi
  repo=$(find_repo_folder) || status=$?
  [[ $status -eq 0 ]] || exit "$status"
  if [[ -z $repo ]]; then
    printf 'omp: %s is not in a git repo. Start omp in a repo folder.\n' "$(tilde "$cwd")" >&2
    exit 64
  fi
  check_srt || exit 1
  preflight || exit 1
  role=$(cd / && BUN_BE_BUN=1 "$omp_bin" "$broker_admin" role "$role_name") || exit 64
  if [[ $role != author ]]; then
    refuse_reviewer_flags ${args[@]+"${args[@]}"} || exit 64
  fi
  rules="$role_rules_root/$role/AGENTS.md"
  drop_secret_env
  repo_hash=$(path_hash "$repo")
  rid="$(basename "$repo")-$repo_hash"
  make_omp_root || exit 1
  state="$ug_root/state/$repo_hash"
  cd "$repo"
  make_state_dir "$ug_root/state" "$state" || exit 1
  stop_failed_brokers "$state"
  if [[ -f $rules ]]; then
    rules_args=(--append-system-prompt "$rules")
  elif [[ $role != author ]]; then
    printf 'omp: the reviewer role %s has no rules in %s; install.sh puts them there\n' "$role_name" "$(tilde "$rules")" >&2
    exit 1
  fi
  if [[ $role != author ]]; then
    make_private_dir "$store_root" || exit 1
    store="$store_root/$role_name/$repo_hash.git"
    make_review_store "$store" || exit 1
  fi
  sessions="$omp_root/agent/sessions/ug-$rid"
  local predict_socket predict_dir native_file="$HOME/.omp/natives/$omp_pin/pi_natives.darwin-arm64.node"
  if [[ ! -f $native_file ]]; then
    (cd / && PI_NATIVES_DIR="$HOME/.omp/natives" "$omp_bin" --help >/dev/null)
  fi
  predict_socket=$(cd / && BUN_BE_BUN=1 "$omp_bin" -e '
const path = require("node:path");
const [state, agent, nativeFile] = process.argv.slice(1);
const { ipcEndpoint } = require(nativeFile);
const hash = Bun.hash.wyhash(path.resolve(agent)).toString(16).padStart(16, "0").slice(0, 12);
console.log(ipcEndpoint(path.join(state, "omp/run/daemons/global/text-predict"), "text-predict-" + hash));
' "$state" "$omp_root/agent" "$native_file")
  if [[ $predict_socket == "/tmp/omp-$(id -u)/"* ]]; then
    make_private_dir "$(dirname "$predict_socket")"
    predict_dir=$(cd -P "$(dirname "$predict_socket")" && pwd) || exit 1
    predict_socket="$predict_dir/${predict_socket##*/}"
  fi
  startup=$("$render_settings" "$role_name" "$role" "$repo" "$repo_hash" "$state" "$sessions" "$predict_socket") || exit
  broker_socket=${startup%%$'\n'*}
  settings=${startup#*$'\n'}
  prefs="$omp_root/agent/prefs.yml"
  printf '{}\n' >"$prefs.tmp.$$" && mv -f "$prefs.tmp.$$" "$prefs" || exit 1
  (cd / && BUN_BE_BUN=1 "$omp_bin" "$HOME/.agents/broker/display-prefs.ts" "$HOME/.omp/agent/config.yml" "$prefs" >/dev/null) || true

  if [[ -n $broker_socket ]]; then
    export UG_BROKER_SOCKET="$broker_socket"
  else
    unset UG_BROKER_SOCKET
  fi
  if [[ -n $store ]]; then
    export UG_REVIEW_STORE="$store"
  else
    unset UG_REVIEW_STORE
  fi
  if [[ -f $rules ]]; then
    export UG_ROLE_RULES="$rules"
  else
    unset UG_ROLE_RULES
  fi
  unset PI_CODING_AGENT_DIR OMP_PROFILE PI_PROFILE OMP_AUTH_BROKER_ACCOUNT_POOL_FILE
  export OMP_AUTH_BROKER_URL="http://127.0.0.1:18765"
  export OMP_AUTH_BROKER_TOKEN="usage-only"
  export OMP_AUTH_BROKER_SNAPSHOT_CACHE="$omp_root/cache/auth-broker-snapshot.enc"
  export PI_CONFIG_DIR="${omp_root#"$HOME"/}"
  export PI_CONFIG_FILES="$omp_root/agent/prefs.yml:$omp_root/agent/policy.yml"
  export PI_NATIVES_DIR="$HOME/.omp/natives"

  export OMP_WORKTREE_DIR="$wt_root/$rid"
  export CARGO_HOME="$cache_root/cargo"
  export npm_config_cache="$cache_root/npm"
  export PIP_CACHE_DIR="$cache_root/pip"
  export UV_CACHE_DIR="$cache_root/uv"
  export GOMODCACHE="$cache_root/go/mod"
  export GOCACHE="$cache_root/go/build"
  export BUN_INSTALL_CACHE_DIR="$cache_root/bun"
  export XDG_CACHE_HOME="$cache_root/xdg"
  export XDG_STATE_HOME="$state"
  export npm_config_prefix="$tool_root"
  export PATH="$HOME/.agents/bin/pinned:$PATH:$tool_root/bin"
  export GIT_CONFIG_GLOBAL=/dev/null
  export GIT_CONFIG_NOSYSTEM=1
  export GIT_CONFIG_COUNT=2
  export GIT_CONFIG_KEY_0=core.excludesFile
  export GIT_CONFIG_VALUE_0=/dev/null
  export GIT_CONFIG_KEY_1=branch.autoSetupMerge
  export GIT_CONFIG_VALUE_1=false

  [[ $role == author ]] || cd "${store%/*}"

  exec "$node_bin" "$srt_cli" --settings "$settings" -- "$HOME/.agents/bin/omp-inner" "$ug_root/tmp" "$omp_bin" --session-dir "$sessions" ${rules_args[@]+"${rules_args[@]}"} ${args[@]+"${args[@]}"}
}

if [[ ${BASH_SOURCE[0]} == "$0" ]]; then
  main "$@"
fi
