#!/usr/bin/env bash
set -euo pipefail

case ${1:-} in
  auth-broker | auth-gateway) ;;
  *)
    printf 'usage: ug-auth auth-broker|auth-gateway <args>\n' >&2
    exit 64
    ;;
esac

self=${BASH_SOURCE[0]}
while [[ -L $self ]]; do
  link=$(readlink "$self")
  [[ $link == /* ]] && self=$link || self="$(dirname "$self")/$link"
done
src=$(cd "$(dirname "$self")/../.." && pwd -P)
pin=$(sed -n 's/^omp=//p' "$src/VERSIONS")
omp="$HOME/.ug/sys/omp/$pin/omp"
[[ -x $omp ]] || { printf 'ug-auth: the pinned omp %s is missing; run host/bin/ug-setup\n' "$omp" >&2; exit 1; }

export PI_CONFIG_DIR=.ug/host/auth
exec "$omp" "$@"
