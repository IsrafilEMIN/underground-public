#!/usr/bin/env bash
# The arena wrapper (docs/SPEC.md, B3; docs/adr/0011-one-agent-arena.md). It starts the pinned omp
# under the pinned srt with the arena ~/.ug/home as HOME, in the arena clone of the repo that the
# owner's checkout names. Setup links it as ~/.ug/sys/bin/omp.
#
# Every session uses the one GitHub broker socket, ~/.ug/run/broker.sock, with no registration
# (docs/SPEC.md, B7). The usage broker is on 127.0.0.1:18765, the auth gateway on the tailscale
# address. The owner's config repo, named in ~/.ug/host/config-repo, holds the agent's rules,
# skills, and settings; each start copies it into the arena (docs/SPEC.md, B3).
# shellcheck disable=SC2016  # single quotes hold node -e code that must not expand here
set -euo pipefail

# Start again with a clean environment, so no variable of the caller (NODE_OPTIONS, GIT_*, a token)
# reaches even the host steps below. Only the names here pass; PATH stays the caller's for the host
# commands, and the sandbox gets its own.
if [[ -z ${UG_ARENA_CLEAN:-} ]]; then
  pass=(UG_ARENA_CLEAN=1 "HOME=$HOME" "PATH=$PATH" "USER=${USER:-$(id -un)}")
  for name in LOGNAME TERM COLORTERM TERM_PROGRAM TERM_PROGRAM_VERSION LANG LC_ALL LC_CTYPE TZ UG_TEST_NODE; do
    [[ -n ${!name:-} ]] && pass+=("$name=${!name}")
  done
  exec env -i "${pass[@]}" /bin/bash "${BASH_SOURCE[0]}" "$@"
fi

self=${BASH_SOURCE[0]}
while [[ -L $self ]]; do
  link=$(readlink "$self")
  [[ $link == /* ]] && self=$link || self="$(dirname "$self")/$link"
done
src=$(cd "$(dirname "$self")/../.." && pwd -P)

node_bin=${UG_TEST_NODE:-/opt/homebrew/bin/node}
ug="$HOME/.ug"
sys="$ug/sys"
arena="$ug/home"
run_root="$ug/run"
addresses="$HOME/.ug/host/addresses"
gateway_token_file="$HOME/.ug/host/auth/auth-gateway.token"
broker_token_file="$HOME/.ug/host/auth/auth-broker.token"
config_repo_file="$HOME/.ug/host/config-repo"
# The names in omp's ~/.omp/agent that the config repo owns (omp docs, config-usage.md, hooks.md,
# omp 18.13.2). Each start replaces each of them in the arena with the repo's copy, and removes one
# that the repo does not have. omp's own data (sessions, agent.db, caches) and secrets
# (secrets.yml, .env) are not on the list.
config_names=(AGENTS.md RULES.md APPEND_SYSTEM.md PERSONALITY.md SYSTEM_TEMPLATE.md WATCHDOG.md TITLE_SYSTEM.md
  config.yml models.yml keybindings.yml lsp.json mcp.json
  agents commands extensions hooks rules skills themes tools)

die() {
  printf 'omp: %s\n' "$*" >&2
  exit "${code:-1}"
}

pin() { sed -n "s/^$1=//p" "$src/VERSIONS"; }
omp_pin=$(pin omp)
srt_pin=$(pin srt)
omp_bin="$sys/omp/$omp_pin/omp"
srt_cli="$sys/srt/$srt_pin/node_modules/@anthropic-ai/sandbox-runtime/dist/cli.js"

for arg in "$@"; do
  case $arg in
    --) break ;;
    --role | --role=*) code=64 die "--role is gone: every session is an author session in the arena" ;;
    --profile | --profile=*) code=64 die "$arg would move omp off its default root in the arena; remove it" ;;
  esac
done

# --- preflight ------------------------------------------------------------------------------------

[[ -x $node_bin ]] || die "missing $node_bin"
[[ -f $omp_bin && -x $omp_bin && ! -L $omp_bin ]] || die "the pinned omp $omp_bin is missing; run $src/host/bin/ug-setup"
[[ -f $srt_cli ]] || die "the pinned srt is missing in $sys/srt/$srt_pin; run $src/host/bin/ug-setup"
[[ -x $sys/libexec/ug-arena-init && -x $sys/agent-bin/broker ]] || die "the arena files are missing in $sys; run $src/host/bin/ug-setup"
want_build=$(cat "$sys/macos-build" 2>/dev/null) || want_build=""
have_build=$(sw_vers -buildVersion 2>/dev/null) || have_build=""
[[ -n $want_build && $have_build == "$want_build" ]] ||
  die "macOS is build ${have_build:-unknown}, but setup proved the sandbox on build ${want_build:-none}; run $src/host/bin/ug-setup"
for dir in "$ug" "$sys" "$run_root"; do
  [[ -d $dir && ! -L $dir && -O $dir ]] || die "$dir must be a folder that you own, not a link; run $src/host/bin/ug-setup"
done
if [[ -e $arena || -L $arena ]]; then
  [[ -d $arena && ! -L $arena && -O $arena ]] || die "$arena must be a folder that you own, not a link"
else
  install -d -m 700 "$arena"
fi
others=$(type -ap omp 2>/dev/null | grep -v -x -F -e "$sys/bin/omp" -e "$src/host/bin/omp-arena" | head -3 | tr '\n' ' ') || true
[[ -z $others ]] || printf 'omp: warning: another omp is on PATH: %s\n' "$others" >&2

# --- the repo -------------------------------------------------------------------------------------

cwd=$(pwd -P)
case $cwd/ in
  "$ug"/*) code=64 die "start omp in your own checkout, not inside $ug: agents write there, and the host runs no git in it" ;;
esac
slug=-
checkout=""
if checkout=$(git -C "$cwd" rev-parse --show-toplevel 2>/dev/null); then
  url=$(git -C "$checkout" config --get remote.origin.url 2>/dev/null) || url=""
  re='^(git@github\.com:|ssh://git@github\.com/|https://github\.com/)([A-Za-z0-9_.-]+)/([A-Za-z0-9_.-]+)$'
  url=${url%/}
  url=${url%.git}
  if [[ $url =~ $re ]]; then
    slug="${BASH_REMATCH[2]}/${BASH_REMATCH[3]}"
  else
    printf 'omp: %s has no GitHub origin, so this session starts in the arena with no repo\n' "$checkout" >&2
    checkout=""
  fi
fi

broker_socket="$run_root/broker.sock"
if [[ ! -S $broker_socket ]]; then
  printf 'omp: the broker socket %s is missing, so this session has no sync, push, PR, or merge; check the launchd job com.underground.broker\n' "$broker_socket" >&2
  broker_socket=""
fi

# --- this session's files in ~/.ug/run ------------------------------------------------------------

find "$run_root" -mindepth 1 -maxdepth 1 -name 'session.*' -mtime +1 -exec rm -rf {} + 2>/dev/null || true
run_dir=$(mktemp -d "$run_root/session.XXXXXX")
gateway=$(sed -n 's/^gateway=//p' "$addresses" 2>/dev/null) || gateway=""
[[ -n $gateway ]] || die "no gateway= line in $addresses"
[[ -f $gateway_token_file ]] || die "missing the gateway bearer $gateway_token_file"

# --- the config repo ------------------------------------------------------------------------------
# The wrapper copies the repo's items into this session's run folder, which the sandbox can read but
# not write; the start step inside the sandbox then puts them in the arena. Everything that it copies
# becomes readable by the agent, so a link (it could point at ~/.ssh), a special file, or a file
# with a token shape or the auth broker's bearer stops the start. models.yml keeps its
# @GATEWAY@ and @GATEWAY_TOKEN@ markers in the repo; the wrapper fills them below.
config_repo=""
if [[ -f $config_repo_file ]]; then
  config_repo=$(sed -n '1p' "$config_repo_file")
  # A leading ~/ in the file means the home folder.
  # shellcheck disable=SC2088  # the ~ is the literal text of the file, not a path to expand here
  [[ ${config_repo:0:2} == "~/" ]] && config_repo="$HOME/${config_repo:2}"
fi
models_src=""
if [[ -z $config_repo ]]; then
  printf 'omp: warning: no config repo is named in %s, so this session keeps the rules, skills, settings, and models.yml that the arena has\n' "$config_repo_file" >&2
elif [[ ! -d $config_repo || -L $config_repo ]]; then
  printf 'omp: warning: the config repo %s is not a folder, so this session keeps the rules, skills, settings, and models.yml that the arena has\n' "$config_repo" >&2
else
  mkdir "$run_dir/config"
  secret_values="$run_dir/secret-values"
  trap 'rm -f "$secret_values"' EXIT
  : >"$secret_values"
  if [[ -f $broker_token_file ]]; then
    value=$(tr -d '[:space:]' <"$broker_token_file")
    [[ ${#value} -lt 12 ]] || printf '%s\n' "$value" >"$secret_values"
  fi
  for name in "${config_names[@]}"; do
    item="$config_repo/$name"
    [[ -e $item || -L $item ]] || continue
    odd=$(find "$item" \( -type l -o ! -type f ! -type d \) -print 2>/dev/null | head -1)
    [[ -z $odd ]] || die "the config repo has a link or a special file, which could bring a file from outside into the sandbox: $odd"
    leak=$(grep -r -l -a -E -f "$src/host/secret-patterns" "$item" 2>/dev/null | head -1) || true
    [[ -n $leak || ! -s $secret_values ]] || leak=$(grep -r -l -a -F -f "$secret_values" "$item" 2>/dev/null | head -1) || true
    [[ -z $leak ]] || die "the config repo file $leak holds a token or a key; the agent can read every file of the config repo, so take it out"
    if [[ $name == models.yml ]]; then
      [[ -f $item ]] || die "the config repo's models.yml is not a file"
      models_src=$item
    else
      cp -R "$item" "$run_dir/config/$name"
    fi
  done
  rm -f "$secret_values"
  [[ -n $models_src ]] || printf 'omp: warning: the config repo %s has no models.yml, so omp reaches no model through the gateway\n' "$config_repo" >&2
  printf '%s\n' "${config_names[@]}" >"$run_dir/config-names"
fi

"$node_bin" -e '
  const fs = require("fs");
  const [runDir, home, arena, sys, src, gateway, tokenFile, brokerSocket, modelsSrc] = process.argv.slice(1);
  if (modelsSrc) {
    const token = fs.readFileSync(tokenFile, "utf8").trim();
    const models = fs.readFileSync(modelsSrc, "utf8").replaceAll("@GATEWAY@", gateway).replaceAll("@GATEWAY_TOKEN@", token);
    const left = /@[A-Z_]+@/.exec(models);
    if (left) { console.error(`omp: models.yml of the config repo has an unknown placeholder ${left[0]}`); process.exit(1); }
    fs.writeFileSync(`${runDir}/config/models.yml`, models, { mode: 0o600 });
  }
  const allowedDomains = fs.readFileSync(`${src}/host/roles/network-allowlist`, "utf8").replaceAll("@GATEWAY@", gateway)
    .split("\n").map((l) => l.replace(/#.*/, "").trim()).filter((l) => l !== "");
  const bad = allowedDomains.find((d) => d.includes("@"));
  if (bad) { console.error(`omp: network-allowlist has an unknown placeholder: ${bad}`); process.exit(1); }
  const sockets = [`${arena}/.omp/run`];
  if (brokerSocket) sockets.unshift(brokerSocket);
  const settings = {
    filesystem: { denyRead: [home], allowRead: [arena, sys, runDir], allowWrite: [arena], denyWrite: [] },
    network: { allowedDomains, deniedDomains: [], allowUnixSockets: sockets, allowLocalBinding: true },
    allowAppleEvents: false,
    allowPty: true,
  };
  fs.writeFileSync(`${runDir}/srt.json`, JSON.stringify(settings, null, 2) + "\n", { mode: 0o600 });
' "$run_dir" "$HOME" "$arena" "$sys" "$src" "$gateway" "$gateway_token_file" "$broker_socket" "$models_src"

# --- start ----------------------------------------------------------------------------------------
# A clean environment: only the variables named here reach srt and omp. srt keeps the real HOME
# for itself and adds its proxy variables; ug-arena-init sets the arena as HOME for omp.
keep=()
for name in TERM COLORTERM TERM_PROGRAM TERM_PROGRAM_VERSION LANG LC_ALL LC_CTYPE TZ; do
  [[ -n ${!name:-} ]] && keep+=("$name=${!name}")
done
[[ -n $broker_socket ]] && keep+=("UG_BROKER_SOCKET=$broker_socket")
# srt adds write denies for .git/hooks, .git/config, .gitconfig, .bashrc, .zshrc, .vscode and others
# beneath the folder that it starts in (srt dist/sandbox/macos-sandbox-utils.js,
# macGetMandatoryDenyEntries). Those protect host tools from agent-written files; the host runs no
# tool in the arena, so there they only cripple git. srt starts in this session's run folder, which
# the sandbox cannot write anyway, so the denies cost nothing and the arena works as a normal home.
cd "$run_dir"
user=${USER:-$(id -un)}
exec env -i HOME="$HOME" USER="$user" LOGNAME="${LOGNAME:-$user}" SHELL=/bin/zsh \
  PATH="$sys/agent-bin:/usr/bin:/bin:/usr/sbin:/sbin:/opt/homebrew/bin" \
  OMP_AUTH_BROKER_URL=http://127.0.0.1:18765 OMP_AUTH_BROKER_TOKEN=usage-only \
  ${keep[@]+"${keep[@]}"} \
  "$node_bin" "$srt_cli" --settings "$run_dir/srt.json" -- "$sys/libexec/ug-arena-init" "$arena" "$run_dir" "$slug" "$omp_bin" "$@"
