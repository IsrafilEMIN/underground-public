#!/usr/bin/env bash
set -euo pipefail

if [[ $# -ne 0 ]]; then
  printf 'usage: ug-install\n' >&2
  exit 64
fi

source_file="$HOME/.agents/install-source"
if ! repo_url=$(cat "$source_file" 2>/dev/null) || [[ -z "${repo_url//[[:space:]]/}" ]]; then
  printf 'ug-install: missing or empty installer source: %s\n' "$source_file" >&2
  exit 1
fi

work_root="$HOME/.agents/install-work"
mkdir -p "$work_root"
chmod 700 "$work_root"
work=$(mktemp -d "$work_root/ug-install.XXXXXX")
trap 'rm -rf "$work"' EXIT

cd /
git -c core.hooksPath=/dev/null clone --quiet --depth 1 --branch main "$repo_url" "$work/src"
cd "$work/src"
bash ./install.sh
