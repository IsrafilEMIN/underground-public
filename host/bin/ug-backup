#!/usr/bin/env bash
set -uo pipefail

if [[ $# -ne 0 ]]; then
  printf 'usage: ug-backup\n' >&2
  exit 64
fi

src=$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd -P)
# shellcheck source=host/lib/ug.bash disable=SC1091
source "$src/host/lib/ug.bash"
restic_pin=$(ug_pin "$src/VERSIONS" restic)
restic_bin="$HOME/.ug/sys/restic/$restic_pin/restic"
backup="$HOME/.ug/host/backup"
config="$backup/config"
agent_tar=${UG_AGENT_HOME_TAR:-/Library/Underground/bin/agent-home-tar}

log() { printf '%s ug-backup: %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$*" >&2; }
die() {
  log "$*"
  exit 1
}

[[ -n $restic_pin && -x $restic_bin ]] || die "the pinned restic $restic_bin is missing; run host/bin/ug-setup"
[[ -s $backup/password ]] || die "the backup password $backup/password is missing; run host/bin/ug-setup"
[[ -f $config ]] || die "no $config; write its repo=, wake=, and sleep= lines (docs/SPEC.md, B10)"
export RESTIC_PASSWORD_FILE="$backup/password"

repo=""
# shellcheck source=host/lib/backup-target.bash disable=SC1091
source "$src/host/lib/backup-target.bash"
backup_target_read "$config"
backup_target_wake

status=0
"$restic_bin" -r "$repo" cat config >/dev/null 2>&1 || status=$?
if [[ $status -eq 10 ]]; then
  if "$restic_bin" -r "$repo" init >/dev/null; then
    log "made the repo $repo"
    status=0
  else
    status=1
  fi
fi
if [[ $status -ne 0 ]]; then
  log "the repo $repo does not open (restic exit $status)"
elif [[ ! -x $agent_tar ]]; then
  log "the agent home reader $agent_tar is missing; run: host/bin/ug-setup"
  status=1
else
  "$restic_bin" -r "$repo" backup --quiet --tag ug-agent --stdin-filename ug-agent-home.tar --stdin-from-command -- sudo -n "$agent_tar"
  status=$?
  [[ $status -ne 0 ]] || date +%s >"$backup/last"
  [[ $status -eq 0 ]] || log "the agent home was not saved (restic exit $status); a failed read stores no snapshot"
fi

backup_target_sleep
[[ $status -eq 0 ]]
