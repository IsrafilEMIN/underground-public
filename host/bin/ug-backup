#!/usr/bin/env bash
set -uo pipefail

if [[ $# -ne 0 ]]; then
  printf 'usage: ug-backup\n' >&2
  exit 64
fi

src=$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd -P)
restic_pin=$(sed -n 's/^restic=//p' "$src/VERSIONS")
restic_bin="$HOME/.ug/sys/restic/$restic_pin/restic"
backup="$HOME/.ug/host/backup"
config="$backup/config"
box_image=""
if [[ -f $HOME/.ug/sys/box/host/lib/box-image.bash ]]; then
  # shellcheck source=host/lib/box-image.bash disable=SC1091
  source "$HOME/.ug/sys/box/host/lib/box-image.bash"
  box_image=$(box_image_tag "$HOME/.ug/sys/box")
fi

log() { printf '%s ug-backup: %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$*" >&2; }
die() {
  log "$*"
  exit 1
}

box_lock="${UG_BOX_STATE:-$HOME/.local/state/underground/box}/ug-box/lock"
lock_wait=${UG_BOX_LOCK_WAIT:-30}
take_box_lock() {
  local waited=0 holder
  mkdir -p "$(dirname "$box_lock")"
  until mkdir "$box_lock" 2>/dev/null; do
    holder=$(cat "$box_lock/pid" 2>/dev/null || true)
    if [[ -n $holder ]] && ! kill -0 "$holder" 2>/dev/null; then
      rm -rf "$box_lock"
      continue
    fi
    (( waited++ < lock_wait * 10 )) || return 1
    sleep 0.1
  done
  echo $$ >"$box_lock/pid"
}

backup_box() {
  local reader locked=0
  [[ -n ${BOX_HOME_TAR:-} ]] || { log "the box home is there but no box is installed to read it; run host/bin/ug-setup"; status=1; return; }
  take_box_lock || { log "ug-box holds its lock, so the box home was not read"; status=1; return; }
  locked=1
  if container list --quiet | grep -qxF ug-box; then
    reader=(container exec ug-box)
    rm -rf "$box_lock"
    locked=0
  elif [[ -n $box_image ]]; then
    reader=(container run --rm --network none --volume ug-box-home:/home/agent "$box_image")
  else
    rm -rf "$box_lock"
    log "the box home is there but no box image is installed to read it; run host/bin/ug-setup"
    status=1
    return
  fi
  "$restic_bin" -r "$repo" backup --quiet --tag ug-box --stdin-filename ug-box-home.tar --stdin-from-command -- "${reader[@]}" sh -c "$BOX_HOME_TAR"
  status=$?
  [[ $locked -eq 0 ]] || rm -rf "$box_lock"
  [[ $status -eq 0 ]] || log "the box home was not saved (restic exit $status); a failed read stores no snapshot"
}

[[ -n $restic_pin && -x $restic_bin ]] || die "the pinned restic $restic_bin is missing; run host/bin/ug-setup"
[[ -s $backup/password ]] || die "the backup password $backup/password is missing; run host/bin/ug-setup"
[[ -f $config ]] || die "no $config; write its repo=, wake=, and sleep= lines (docs/SPEC.md, B10)"
export RESTIC_PASSWORD_FILE="$backup/password"

repo=""
# shellcheck source=host/lib/backup-target.bash disable=SC1091
source "$src/host/lib/backup-target.bash"
backup_target_read "$config"
backup_target_wake

status=0
"$restic_bin" -r "$repo" cat config >/dev/null 2>&1 || status=$?
if [[ $status -eq 10 ]]; then
  if "$restic_bin" -r "$repo" init >/dev/null; then
    log "made the repo $repo"
    status=0
  else
    status=1
  fi
fi
if [[ $status -ne 0 ]]; then
  log "the repo $repo does not open (restic exit $status)"
else
  "$restic_bin" -r "$repo" backup --quiet --tag ug --exclude-caches \
    --exclude "$HOME/.ug/home/tmp" --exclude "$HOME/.ug/home/.omp/agent/cache" \
    --exclude "$HOME/.ug/home/.cache" --exclude node_modules \
    "$HOME/.ug/home"
  status=$?
  if [[ $status -eq 0 || $status -eq 3 ]]; then
    [[ $status -eq 0 ]] || log "some files could not be read (restic exit 3); the snapshot holds the rest"
    status=0
  else
    log "the backup to $repo failed with restic exit $status"
  fi
  if [[ $status -eq 0 ]]; then
    if ! command -v container >/dev/null 2>&1; then
      log "the container CLI is not on PATH, so the box home cannot be read"
      status=1
    elif ! volumes=$(container volume list --quiet); then
      log "container volume list failed, so the box home cannot be read"
      status=1
    elif grep -qxF ug-box-home <<<"$volumes"; then
      backup_box
    fi
  fi
  [[ $status -ne 0 ]] || date +%s >"$backup/last"
fi

backup_target_sleep
[[ $status -eq 0 ]]
