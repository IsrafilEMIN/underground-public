#!/usr/bin/env bash
set -Eeuo pipefail

if [[ $# -ne 0 ]]; then
  printf 'usage: ug-setup\n' >&2
  exit 64
fi

src=$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd -P)
data="$HOME/.local/share/underground"
real=$(cd "$data" 2>/dev/null && pwd -P) || real=$data
case $src/ in
  "$data/"* | "$real/"*)
    printf 'ug-setup: %s is inside %s, which setup itself writes; run setup from your own checkout\n' "$src" "$data" >&2
    exit 64
    ;;
esac
bin_dir="$HOME/.local/bin"
root=/Library/Underground
node_bin=/opt/homebrew/bin/node
labels="com.underground.gh-broker com.underground.backup"
agents_dir="$HOME/Library/LaunchAgents"
addresses_file="$data/addresses"
engine_default=100.64.0.99:8081
tailscale_app=/Applications/Tailscale.app/Contents/MacOS/Tailscale

green="" red="" yellow="" plain="" err_red="" err_plain=""
if [[ -z ${NO_COLOR:-} && ${TERM:-dumb} != dumb ]]; then
  [[ ! -t 1 ]] || { green=$'\e[32m' red=$'\e[31m' yellow=$'\e[33m' plain=$'\e[0m'; }
  [[ ! -t 2 ]] || { err_red=$'\e[31m' err_plain=$'\e[0m'; }
fi

die() {
  printf '%sug-setup: %s%s\n' "$err_red" "$*" "$err_plain" >&2
  exit 1
}

stopped() {
  local status=$1 line=$2 command=$3
  (( BASH_SUBSHELL == 0 )) || return 0
  printf '%sug-setup: stopped at line %s of host/bin/ug-setup: "%s" failed with exit %s. The steps above it are done, and nothing after it ran. Fix the cause, then run host/bin/ug-setup again.%s\n' "$err_red" "$line" "$command" "$status" "$err_plain" >&2
}
trap 'stopped $? $LINENO "$BASH_COMMAND"' ERR

later=()

# shellcheck source=host/lib/ug.bash disable=SC1091
source "$src/host/lib/ug.bash"
if [[ ${UG_SETUP_PULLED:-} != 1 ]]; then
  ug_pull_main "$src" ug-setup || exit 1
  UG_SETUP_PULLED=1 exec "$BASH" "$src/host/bin/ug-setup"
fi
ug_check_checkout "$src" ug-setup || exit 1
pin() {
  local value
  value=$(ug_pin "$src/VERSIONS" "$1")
  [[ $value =~ $2 ]] || die "bad pin for $1 in VERSIONS"
  printf '%s\n' "$value"
}

sha256() {
  local out
  out=$(shasum -a 256 "$1") || return 1
  printf '%s\n' "${out%% *}"
}

omp_pin=$(pin omp '^[0-9A-Za-z.+-]+$')
omp_sha=$(pin omp_sha256 '^[0-9a-f]{64}$')
omp_release=$(pin omp_release '^https://github\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+/releases/download$')
restic_pin=$(pin restic '^[0-9A-Za-z.+-]+$')
restic_sha=$(pin restic_sha256 '^[0-9a-f]{64}$')
restic_bz2_sha=$(pin restic_bz2_sha256 '^[0-9a-f]{64}$')
restic_release=$(pin restic_release '^https://github\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+/releases/download$')

[[ $(uname -s) == Darwin && $(uname -m) == arm64 ]] || die "the omp pin names omp-darwin-arm64; this mac is $(uname -s) $(uname -m)"
[[ -x $node_bin ]] || die "missing $node_bin"
for name in omp ug-auth; do
  [[ ! -e $bin_dir/$name || -L $bin_dir/$name ]] || die "$bin_dir/$name is a file, not setup's link; move it away, then run setup again"
done

cleanup=()
trap '[[ ${#cleanup[@]} -eq 0 ]] || rm -rf "${cleanup[@]}"' EXIT

run_mac_only_tests() {
  local report="$data/state/mac-tests.tap" status=0 pass fail skip problems
  install -d -m 700 "$data" "$data/state"
  rm -f "$report"
  printf 'mac tests: the tests that only this mac can run\n'
  (cd "$src" && "$node_bin" --test --test-reporter=tap --test-reporter-destination="$report" \
    --test-name-pattern='\[mac\]' tests/broker/*.test.ts tests/host/*.test.ts) || status=$?
  [[ -f $report ]] || die "mac tests: node wrote no report (exit $status), so nothing is set up"
  awk -v pass="$green" -v fail="$red" -v skip="$yellow" -v off="$plain" -f "$src/host/lib/mac-tests.awk" "$report"
  fail=$(grep -cE '^not ok [0-9]+ - ' "$report") || true
  skip=$(grep -cE '^ok [0-9]+ - \[mac\] .* # SKIP' "$report") || true
  pass=$(grep -cE '^ok [0-9]+ - \[mac\] ' "$report") || true
  pass=$(( ${pass:-0} - ${skip:-0} ))
  if (( status != 0 || ${fail:-0} > 0 || ${skip:-0} > 0 )); then
    problems=""
    (( ${fail:-0} == 0 )) || problems="$fail failed"
    (( ${skip:-0} == 0 )) || problems="${problems:+$problems, }$skip skipped"
    [[ -n $problems ]] || problems="node exited $status"
    die "mac tests: $problems, so nothing is set up; full report: $report"
  fi
  printf '%smac tests: %s passed%s\n' "$green" "$pass" "$plain"
}
run_mac_only_tests

omp_stage=""
stage_omp() {
  local dest="$root/omp/$omp_pin/omp" have url
  if [[ -f $dest.sha256 && $(<"$dest.sha256") == "$omp_sha" ]]; then
    printf 'omp %s: in place in %s\n' "$omp_pin" "$dest"
    return 0
  fi
  url="$omp_release/v$omp_pin/omp-darwin-arm64"
  omp_stage=$(mktemp "${TMPDIR:-/tmp}/ug-omp-download.XXXXXX")
  cleanup+=("$omp_stage")
  curl -fsSL --proto '=https' --retry 3 -o "$omp_stage" "$url" || die "download of $url failed"
  have=$(sha256 "$omp_stage")
  [[ $have == "$omp_sha" ]] || die "omp $omp_pin from $url has SHA-256 $have, want $omp_sha; nothing changed"
  printf 'omp %s: downloaded and checked; the root step installs it in %s\n' "$omp_pin" "$dest"
}

stage_omp
install -d -m 700 "$data" "$data/restic"
[[ -d $bin_dir ]] || install -d -m 755 "$bin_dir"

install_restic() {
  local dir="$data/restic/$restic_pin" dest tmp bin have url
  dest="$dir/restic"
  if [[ -f $dest && ! -L $dest ]] && [[ $(sha256 "$dest") == "$restic_sha" ]]; then
    printf 'restic %s: in place\n' "$restic_pin"
    return 0
  fi
  url="$restic_release/v$restic_pin/restic_${restic_pin}_darwin_arm64.bz2"
  tmp=$(mktemp "$data/restic/.download.XXXXXX")
  bin=$(mktemp "$data/restic/.binary.XXXXXX")
  cleanup+=("$tmp" "$bin")
  curl -fsSL --proto '=https' --retry 3 -o "$tmp" "$url" || die "download of $url failed"
  have=$(sha256 "$tmp")
  [[ $have == "$restic_bz2_sha" ]] || die "restic $restic_pin from $url has SHA-256 $have, want $restic_bz2_sha; nothing changed"
  bunzip2 -c "$tmp" >"$bin" || die "bunzip2 of $url failed; nothing changed"
  have=$(sha256 "$bin")
  [[ $have == "$restic_sha" ]] || die "restic $restic_pin unpacked has SHA-256 $have, want $restic_sha; nothing changed"
  chmod 555 "$bin"
  install -d -m 700 "$dir"
  mv -f "$bin" "$dest"
  printf 'restic %s: installed in %s\n' "$restic_pin" "$dest"
}

setup_backup() {
  local backup="$data/backup"
  install -d -m 700 "$backup"
  if [[ ! -s $backup/password ]]; then
    (umask 077 && openssl rand -base64 32 >"$backup/password") || die "cannot write $backup/password"
    printf 'backup: made the password %s\n' "$backup/password"
    later+=("keep a copy of $backup/password in your password manager; without it, the backup cannot be opened after a loss of this mac")
  fi
  if [[ ! -f $backup/config ]]; then
    later+=("write $backup/config with its repo=, wake=, and sleep= lines (docs/SPEC.md, B10); until then, no backup runs")
  fi
}

put() {
  local from=$1 to=$2 mode=$3 tmp
  tmp=$(mktemp "$(dirname "$to")/.put.XXXXXX")
  cleanup+=("$tmp")
  cat "$from" >"$tmp"
  chmod "$mode" "$tmp"
  mv -f "$tmp" "$to"
}

link() {
  local target=$1 at=$2
  rm -f "$at"
  ln -s "$target" "$at"
}

rename_broker() {
  local label=com.underground.broker old="$data/broker" new="$data/gh-broker"
  if [[ -e $agents_dir/$label.plist ]] || launchctl print "gui/$UID/$label" >/dev/null 2>&1; then
    launchctl bootout "gui/$UID/$label" >/dev/null 2>&1 || true
    rm -f "$agents_dir/$label.plist"
    printf 'gh-broker: booted out and deleted the old agent %s\n' "$label"
  fi
  if [[ -e $old || -L $old ]]; then
    [[ ! -e $new && ! -L $new ]] || die "both $old and $new exist; keep the one with the current records, then run setup again"
    mv "$old" "$new"
    printf 'gh-broker: moved the records from %s to %s\n' "$old" "$new"
  fi
}

install_service_code() {
  local dir="$data/services" f
  rm -rf "$dir"
  install -d -m 700 "$dir" "$dir/host/bin" "$dir/host/lib" "$dir/host/gh-broker"
  for f in host/bin/ug-backup host/bin/ug-auth host/lib/backup-target.bash host/lib/ug.bash VERSIONS "$src"/host/gh-broker/*.ts; do
    f=${f#"$src/"}
    put "$src/$f" "$dir/$f" 444
  done
  chmod 555 "$dir/host/bin/ug-backup" "$dir/host/bin/ug-auth"
  link "$dir/host/bin/ug-auth" "$bin_dir/ug-auth"
  printf 'services: code installed in %s, ug-auth on PATH as %s\n' "$dir" "$bin_dir/ug-auth"
}

write_addresses() {
  local tailscale out ip tmp
  if [[ -e $addresses_file || -L $addresses_file ]]; then
    printf 'addresses: %s in place\n' "$addresses_file"
    return 0
  fi
  if command -v tailscale >/dev/null 2>&1; then
    tailscale=tailscale
  elif [[ -x $tailscale_app ]]; then
    tailscale=$tailscale_app
  else
    die "tailscale is not installed; install it, or write $addresses_file with the lines gateway=<tailscale address of this mac>:4000 and engine=$engine_default"
  fi
  out=$("$tailscale" ip -4 2>&1) || true
  ip=${out%%$'\n'*}
  [[ $ip =~ ^[0-9]{1,3}(\.[0-9]{1,3}){3}$ ]] ||
    die "tailscale ip -4 gave no IPv4 address${out:+ (it printed: ${out//$'\n'/ })}; start tailscale, or write $addresses_file with gateway=<ip>:4000 and engine=$engine_default"
  tmp=$(mktemp "$addresses_file.XXXXXX")
  cleanup+=("$tmp")
  printf 'gateway=%s:4000\nengine=%s\n' "$ip" "$engine_default" >"$tmp"
  chmod 600 "$tmp"
  mv -f "$tmp" "$addresses_file"
  printf 'addresses: wrote %s with gateway=%s:4000 and engine=%s\n' "$addresses_file" "$ip" "$engine_default"
}

prepare_services() {
  install -d -m 700 "$data/gh-broker" "$data/gh-broker/repos" "$data/gh-broker/tmp" "$data/gh-broker/reviews" "$data/gh-broker/pushes" "$data/state"
  write_addresses
}

start_services() {
  local label rendered left out fp inputs answers log
  install -d "$agents_dir"
  for label in $labels; do
    rendered=$(mktemp "$agents_dir/.$label.XXXXXX")
    cleanup+=("$rendered")
    sed -e "s|@DATA@|$data|g" -e "s|@HOME@|$HOME|g" "$src/host/launchd/$label.plist" >"$rendered"
    left=$(grep -o '@[A-Z_]*@' "$rendered" | head -1) || true
    [[ -z $left ]] || die "host/launchd/$label.plist has an unknown placeholder $left"
    case $label in
      com.underground.gh-broker)
        inputs=("$node_bin" "$data"/services/host/gh-broker/*.ts)
        answers=(ug_socket_answers "$root/run/gh-broker.sock")
        log=$data/gh-broker/gh-broker.log
        ;;
      *)
        inputs=()
        answers=(true)
        log=$data/backup/backup.log
        ;;
    esac
    fp=$(ug_fingerprint "$rendered" ${inputs[@]+"${inputs[@]}"}) || die "cannot read the inputs of $label"
    out=$(ug_ensure_service "gui/$UID" "$label" "$rendered" "$agents_dir/$label.plist" "$data/state/$label.fingerprint" "$fp" "${answers[@]}") ||
      die "$out; read $log"
    printf 'service %s: %s\n' "$label" "$out"
  done
}

check_path() {
  local dirs dir found=()
  IFS=: read -r -a dirs <<<"$PATH"
  for dir in "${dirs[@]}"; do
    [[ -n $dir && -x $dir/omp && ! -d $dir/omp ]] && found+=("$dir/omp")
  done
  if [[ ${#found[@]} -eq 0 ]]; then
    later+=("no omp is on PATH; put $bin_dir on PATH, so that omp starts the agent")
  elif [[ ${found[0]} != "$bin_dir/omp" ]]; then
    later+=("the first omp on PATH is ${found[0]}, not the agent launcher $bin_dir/omp; put $bin_dir on PATH before ${found[0]%/omp}")
  elif [[ ${#found[@]} -gt 1 ]]; then
    later+=("more than one omp is on PATH: ${found[*]}; remove all but $bin_dir/omp")
  fi
}

finish() {
  if [[ ${#later[@]} -eq 0 ]]; then
    printf '%sug-setup: done; nothing is left to do%s\n' "$green" "$plain"
    return 0
  fi
  printf '%sug-setup: done.%s %sstill to do:%s\n' "$green" "$plain" "$yellow" "$plain"
  local item
  for item in "${later[@]}"; do
    printf '  %s-%s %s\n' "$yellow" "$plain" "$item"
  done
}

check_walls() {
  local bad=() text me
  me=$(id -un)
  [[ ! -x $root/omp/$omp_pin/omp ]] || bad+=("you can run $root/omp/$omp_pin/omp, so you are in the group ugomp (remove yourself: sudo dseditgroup -o edit -d $me -t user ugomp)")
  [[ ! -r $root/config/models.yml ]] || bad+=("you can read the gateway bearer in $root/config/models.yml, so you are in the group ugagent (remove yourself: sudo dseditgroup -o edit -d $me -t user ugagent)")
  ! ls /Users/ugauth >/dev/null 2>&1 || bad+=("you can read the login user's home /Users/ugauth (close it: sudo chmod 700 /Users/ugauth)")
  if [[ ${#bad[@]} -gt 0 ]]; then
    text=$(printf '%s; ' "${bad[@]}")
    die "a wall is open: ${text%; }. Close it, then run host/bin/ug-setup again"
  fi
  printf 'walls: you cannot run omp, read the bearer, or read the logins\n'
  if [[ -e $HOME/.omp/profiles/ug-auth ]]; then
    later+=("$HOME/.omp/profiles/ug-auth still holds old logins; log in again with ug-auth, sign out of the old sessions at each provider, then delete it")
  fi
}

install_restic
rename_broker
install_service_code
setup_backup
prepare_services
printf 'agent user: running sudo host/bin/ug-agent-setup, which asks for your password\n'
sudo "$src/host/bin/ug-agent-setup" ${omp_stage:+"$omp_stage"} || die "ug-agent-setup failed, so the agent user is not up to date; fix its error and run host/bin/ug-setup again"
start_services
check_walls
check_path
finish
