{
  "skillLinkRoots": ["@HOME@/Developer/Projects/arkan/skills"],
  "filesystem": {
    "denyRead": ["@HOME@"],
    "allowRead": [
      "@ROLE@",
      "@HOME@/.omp/natives",
      "@HOME@/.agents/bin",
      "@HOME@/.agents/broker/client.ts",
      "@HOME@/.agents/broker/protocol.ts",
      "@HOME@/.agents/AGENTS.md",
      "@HOME@/.agents/skills",
      "@HOME@/Library/Application Support/Tern/omp"
    ],
    "allowWrite": ["@ROLE@"],
    "denyWrite": [
      "**/.envrc",
      "**/.git/modules/**/hooks",
      "**/.git/modules/**/config",
      "@HOME@/.omp/wt/**/.omp",
      "**/.vscode",
      "**/.idea",
      "**/.claude",
      "**/.mcp.json"
    ]
  },
  "network": {
    "deniedDomains": [],
    "allowUnixSockets": [],
    "allowLocalBinding": true
  },
  "allowAppleEvents": false,
  "allowPty": true
}
