(version 1)
(allow default)
(deny process-exec (literal "/bin/launchctl") (literal "/usr/bin/at") (literal "/usr/bin/crontab") (literal "/usr/bin/batch"))
(deny file-read* (require-not (require-any
  (literal "/") (literal "/Users") (literal "/private") (literal "/private/var")
  (literal "/etc") (literal "/tmp") (literal "/var")
  (subpath "/Users/ugagent")
  (subpath "/System") (subpath "/usr") (subpath "/bin") (subpath "/sbin")
  (subpath "/Library") (subpath "/Applications") (subpath "/dev")
  (subpath "/private/etc") (subpath "/private/var/db/timezone") (literal "/private/var/db/xcode_select_link")
  (subpath "/private/var/select") (subpath "/private/var/run") (subpath "/private/var/folders"))))
(allow file-read-metadata)
(deny file-write* (require-not (subpath "/Users/ugagent")))
(allow file-write* (literal "/dev/null") (regex #"^/dev/tty") (subpath "/private/var/folders"))
(deny file-write* (subpath "/Users/ugagent/.ssh") (literal "/Users/ugagent/.zshenv") (literal "/Users/ugagent/.zprofile") (literal "/Users/ugagent/.zshrc") (literal "/Users/ugagent/.zlogin") (literal "/Users/ugagent/.profile") (literal "/Users/ugagent/.bash_profile") (literal "/Users/ugagent/.bash_login") (literal "/Users/ugagent/.bashrc"))
