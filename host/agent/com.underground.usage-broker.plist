<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.underground.usage-broker</string>
  <key>UserName</key>
  <string>ugauth</string>
  <key>ProgramArguments</key>
  <array>
    <string>@OMP@</string>
    <string>/Library/Underground/usage-broker/usage-broker.ts</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/Users/ugauth</string>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/Users/ugauth/logs/usage-broker.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/ugauth/logs/usage-broker.log</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key>
    <string>/Users/ugauth</string>
    <key>PATH</key>
    <string>/usr/bin:/bin</string>
    <key>BUN_BE_BUN</key>
    <string>1</string>
  </dict>
</dict>
</plist>
