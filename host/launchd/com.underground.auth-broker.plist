<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.underground.auth-broker</string>
  <key>ProgramArguments</key>
  <array>
    <string>@OMP@</string>
    <string>auth-broker</string>
    <string>serve</string>
    <string>--bind=127.0.0.1:8765</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardOutPath</key>
  <string>@HOME@/.ug/host/auth/auth-broker.log</string>
  <key>StandardErrorPath</key>
  <string>@HOME@/.ug/host/auth/auth-broker.log</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/bin:/bin</string>
    <key>PI_CONFIG_DIR</key>
    <string>.ug/host/auth</string>
  </dict>
</dict>
</plist>
