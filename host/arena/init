#!/bin/sh
# The first step of a session inside the sandbox (docs/SPEC.md, B3 and B4). The wrapper starts it
# through srt; it sets the arena as HOME, puts the owner's files in place, makes or finds the
# repo's arena clone, and then starts omp there. Everything that writes the arena runs here,
# inside the sandbox, so a link that an agent planted in the arena can only lead into the arena.
#
#   init <arena> <run-dir> <owner/repo or -> <omp> [omp args...]
set -eu

if [ $# -lt 4 ]; then
  printf 'ug-arena-init: usage: init <arena> <run-dir> <owner/repo|-> <omp> [args...]\n' >&2
  exit 64
fi
arena=$1
run_dir=$2
slug=$3
omp=$4
shift 4

p=${https_proxy:-${HTTPS_PROXY:-}}
if [ -n "$p" ]; then
  PI_PROXY=$p
  export PI_PROXY
fi
HOME=$arena
TMPDIR=$arena/tmp
export HOME TMPDIR

mkdir -p "$HOME/tmp" "$HOME/.omp/agent" "$HOME/work"

# Replace, never write through: rm removes a planted link itself, then cp writes a new file.
put() {
  rm -f "$2"
  cp "$1" "$2"
}
put "$run_dir/models.yml" "$HOME/.omp/agent/models.yml"
if [ ! -e "$HOME/.omp/agent/config.yml" ] && [ ! -L "$HOME/.omp/agent/config.yml" ]; then
  cp "$run_dir/config.yml" "$HOME/.omp/agent/config.yml"
fi

case $slug in
  -)
    cd "$HOME/work"
    exec "$omp" "$@"
    ;;
  */*) ;;
  *)
    printf 'ug-arena-init: bad repo %s\n' "$slug" >&2
    exit 64
    ;;
esac

clone=$HOME/work/$slug
OMP_WORKTREE_DIR=$HOME/.omp/wt/$(printf '%s' "$slug" | tr '/' '-')
export OMP_WORKTREE_DIR
mkdir -p "$OMP_WORKTREE_DIR"

# A clone is whole when its HEAD names a commit. One that is not (a start that stopped halfway)
# is made again. A new clone is built in a temp folder and moved into place only when it is whole.
if [ -d "$clone" ] && ! git -C "$clone" rev-parse --verify -q HEAD >/dev/null 2>&1; then
  printf 'ug-arena-init: %s is not a whole clone; making it again\n' "$clone" >&2
  rm -rf "$clone"
fi
if [ ! -d "$clone" ]; then
  if [ -z "${UG_BROKER_SOCKET:-}" ]; then
    printf 'ug-arena-init: %s has no arena clone yet, and this session has no broker to make one\n' "$slug" >&2
    exit 69
  fi
  mkdir -p "$(dirname "$clone")"
  tmp=$(mktemp -d "$HOME/work/.new.XXXXXX")
  trap 'rm -rf "$tmp"' EXIT
  cd "$tmp"
  git init -q
  git remote add origin "https://github.com/$slug.git"
  synced=$(broker sync "$slug") || {
    printf 'ug-arena-init: broker sync %s failed; nothing was made\n' "$slug" >&2
    exit 69
  }
  branch=$(printf '%s\n' "$synced" | sed -n 's|^origin/\([^ ]*\) is now .*|\1|p')
  if [ -z "$branch" ]; then
    printf 'ug-arena-init: broker sync gave no branch: %s\n' "$synced" >&2
    exit 69
  fi
  git checkout -q -B "$branch" "origin/$branch"
  cd "$HOME/work"
  mv "$tmp" "$clone"
  trap - EXIT
fi

cd "$clone"
exec "$omp" "$@"
